! @File    :   cudaBCRoutines.cuf
! @Desc    :   This module contains the CUDA Fortran version of the boundary condition routines in BCRoutines.F90

module cudaBCRoutines
    !
    !   CUDA Modules
    !
    ! --- CUDA FORTRAN module ---
    use cudafor

    !
    !   ADflow modules
    !
    use precision, only: intType, realType
    use cudaBlock, only: cudaDoms => d_cudaDoms, BCData => d_BCData, h_BCData

    implicit none
    save

contains

    !
    !   API Routines
    !

    subroutine applyAllBC(secondHalo)
        !
        !       Applies all boundary conditions for the all
        !       device blocks on the grid level currentLevel.
        !
        use constants
        use blockPointers, only: nDom
        use inputTimeSpectral, only: nTimeIntervalsSpectral
        use iteration, only: currentLevel
        use utils, only: setPointers
        use ALEUtils, only: interpLevelALEBC_Block, recoverLevelALEBC_block
        implicit none

        !
        !       Subroutine arguments
        !
        logical, intent(in) :: secondHalo

        !
        !       Local variables
        !
        integer(kind=intType) :: sps, nn

        ! manually skip time spectral and multigrid for now
        nTimeIntervalsSpectral = 1
        currentLevel = 1

        ! Loop over the number of spectral solutions and number of blocks.
        spectralLoop: do sps = 1, nTimeIntervalsSpectral
            domains: do nn = 1, nDom
                ! Set the pointers for this block.
                call setPointers(nn, currentLevel, sps)

                call interpLevelALEBC_block

                call applyAllBC_block(secondHalo)
                call recoverLevelALEBC_block
            end do domains
        end do spectralLoop

    end subroutine applyAllBC

    subroutine applyAllBC_block(secondHalo)
        !
        !       Applies all BCs for a single device block
        !       TODO: Only supports symmetry, farfield,
        !       adiabatic wall, and euler wall BCs currently!
        !
        use constants, only: symm, NSWallAdiabatic, farField, EulerWall
        use blockPointers, only: nDom, nBocos, BCType, BCFaceID, nViscBocos, BCData, &
                                 bib=>ib, bjb=>jb, bkb=>kb
        use utils, only: setPointers, getCorrectForK
        use inputTimeSpectral, only: nTimeIntervalsSpectral
        implicit none

        !
        !       Subroutine arguments
        !
        logical, intent(in) :: secondHalo

        !
        !       Local variables
        !
        type(dim3) :: grid_size, block_size
        integer(kind=intType) :: ibmax, jbmax, kbmax
        logical :: correctForK
        integer(kind=intType) :: nn
        integer(kind=intType) :: istat, dom, sps
        integer(kind=intType) :: h_iStart, h_iEnd, h_iSize, h_jStart, h_jEnd, h_jSize

        !
        !  Determine size of largest block dims
        !
        ibmax = 0
        jbmax = 0
        kbmax = 0
        do dom = 1, nDom
            do sps = 1, nTimeIntervalsSpectral
                call setPointers(dom, 1, sps)
                ibmax = max(ibmax, bib)
                jbmax = max(jbmax, bjb)
                kbmax = max(kbmax, bkb)
            end do
        end do

        !
        !  Compute GPU block and grid size
        !
        block_size = dim3(8, 8, 1)
        grid_size  = dim3(ceiling(real(max(ibmax, jbmax, kbmax)+1) / block_size%x), &
                          ceiling(real(max(ibmax, jbmax, kbmax)+1) / block_size%y), 1)

        ! call CPU_TIME(start)

        !
        ! Determine whether or not the total energy must be corrected
        ! for the presence of the turbulent kinetic energy.
        !
        correctForK = getCorrectForK()

        !
        ! Apply all the boundary conditions. The order is important!
        !

        ! ------------------------------------
        !  Symmetry Boundary Condition
        ! ------------------------------------
        !$AD II-LOOP
        do nn = 1, nBocos
            if (BCType(nn) .eq. symm) then
                ! Get the face index bounds
                h_iStart = BCData(nn)%icBeg
                h_iEnd = BCData(nn)%icEnd
                h_jStart = BCData(nn)%jcBeg
                h_jEnd = BCData(nn)%jcEnd
                h_iSize = h_iEnd - h_iStart + 1
                h_jSize = h_jEnd - h_jStart + 1

                ! Run routine on GPU
                call bcSymm1stHalo<<<grid_size, block_size>>>(nn, BCFaceID(nn), &
                    h_iStart, h_jStart, h_iSize, h_jSize)
                ! istat = cudaDeviceSynchronize()
            end if
        end do

        if (secondHalo) then
            !$AD II-LOOP
            do nn = 1, nBocos
                if (BCType(nn) .eq. symm) then
                    ! Get the face index bounds
                    h_iStart = BCData(nn)%icBeg
                    h_iEnd = BCData(nn)%icEnd
                    h_jStart = BCData(nn)%jcBeg
                    h_jEnd = BCData(nn)%jcEnd
                    h_iSize = h_iEnd - h_iStart + 1
                    h_jSize = h_jEnd - h_jStart + 1

                    ! Run routine on GPU
                    call bcSymm2ndHalo<<<grid_size, block_size>>>(nn, BCFaceID(nn), &
                        h_iStart, h_jStart, h_iSize, h_jSize)
                    !    istat = cudaDeviceSynchronize()
                end if
            end do
        end if

       ! ------------------------------------
       !  Symmetry Polar Boundary Condition
       ! ------------------------------------
       !$AD II-LOOP
    !    do nn = 1, nBocos
    !        if (BCType(nn) == symmPolar) then
    !            call setBCPointers(nn, .True.)
    !            ! Then copy all data to device
    !            call copyCudaBC
       
    !            call bcSymmPolar1stHalo(nn)
    !        end if
    !    end do

    !    if (secondHalo) then
    !        !$AD II-LOOP
    !        do nn = 1, nBocos
    !            if (BCType(nn) == symmPolar) then
    !                call setBCPointers(nn, .True.)
    !                ! Then copy all data to device
    !                call copyCudaBC
       
    !                call bcSymmPolar2ndHalo(nn)
    !            end if
    !        end do
    !    end if

       ! ------------------------------------
       !  Adibatic Wall Boundary Condition
       ! ------------------------------------
        !$AD II-LOOP
        do nn = 1, nViscBocos
            if (BCType(nn) .eq. NSWallAdiabatic) then
                ! Get the face index bounds
                h_iStart = BCData(nn)%icBeg
                h_iEnd = BCData(nn)%icEnd
                h_jStart = BCData(nn)%jcBeg
                h_jEnd = BCData(nn)%jcEnd
                h_iSize = h_iEnd - h_iStart + 1
                h_jSize = h_jEnd - h_jStart + 1

                ! Run routine on GPU
                call bcNSWallAdiabatic<<<grid_size, block_size>>>(nn, BCFaceID(nn), &
                     h_iStart, h_jStart, h_iSize, h_jSize, secondHalo, correctForK)
                !    istat = cudaDeviceSynchronize()
            end if
        end do

       ! ------------------------------------
       !  Isotermal Wall Boundary Condition
       ! ------------------------------------
       !$AD II-LOOP
    !    do nn = 1, nViscBocos
    !        if (BCType(nn) == NSWallIsoThermal) then
    !            call setBCPointers(nn, .False.)
    !            ! Then copy all data to device
    !            call copyCudaBC
       
    !            call bcNSWallIsothermal(nn, secondHalo, correctForK)
    !        end if
    !    end do

        ! ------------------------------------
        !  Farfield Boundary Condition
        ! ------------------------------------
        !$AD II-LOOP
        do nn = 1, nBocos
            if (BCType(nn) .eq. farField) then
                ! Get the face index bounds
                h_iStart = BCData(nn)%icBeg
                h_iEnd = BCData(nn)%icEnd
                h_jStart = BCData(nn)%jcBeg
                h_jEnd = BCData(nn)%jcEnd
                h_iSize = h_iEnd - h_iStart + 1
                h_jSize = h_jEnd - h_jStart + 1

                ! Run routine on GPU
                call bcFarField<<<grid_size, block_size>>>(nn, BCFaceID(nn), &
                     h_iStart, h_jStart, h_iSize, h_jSize, secondHalo, correctForK)
                !    istat = cudaDeviceSynchronize()
            end if
        end do
!
!        ! ! ------------------------------------
!        ! !  Subsonic Outflow Boundary Condition
!        ! ! ------------------------------------
!        ! do nn = 1, nBocos
!        !     if (BCType(nn) == subSonicOutFlow .or. &
!        !         BCType(nn) == MassBleedOutflow) then
!        !         call setBCPointers(nn, .False.)
!        !         ! Then copy all data to device
!        !         call copyCudaBC
!        !
!        !         call bcSubSonicOutFlow(nn, secondHalo, correctForK)
!        !     end if
!        ! end do
!
!        ! ! ------------------------------------
!        ! !  Subsonic Inflow Boundary Condition
!        ! ! ------------------------------------
!        ! do nn = 1, nBocos
!        !     if (BCType(nn) == subSonicInFlow) then
!        !         call setBCPointers(nn, .False.)
!        !         ! Then copy all data to device
!        !         call copyCudaBC
!        !
!        !         call bcSubSonicInflow(nn, secondHalo, correctForK)
!        !     end if
!        ! end do
!
!        ! ! ------------------------------------
!        ! !  Extrapolation Boundary Condition
!        ! ! ------------------------------------
!        ! ! Extrapolation boundary conditions; this also includes
!        ! ! the supersonic outflow boundary conditions. The difference
!        ! ! between the two is that the extrap boundary conditions
!        ! ! correspond to singular lines and supersonic outflow
!        ! ! boundaries to physical boundaries. The treatment however
!        ! ! is identical.
!        ! do nn = 1, nBocos
!        !     if (BCType(nn) == extrap .or. &
!        !         BCType(nn) == SupersonicOutFlow) then
!        !         call setBCPointers(nn, .False.)
!        !         call bcExtrap(nn, secondHalo, correctForK)
!        !     end if
!        ! end do
!
!        ! ! ------------------------------------
!        ! !  Euler Wall Boundary Condition
!        ! ! ------------------------------------
        !$AD II-LOOP
        do nn = 1, nBocos
            if (BCType(nn) .eq. EulerWall) then
                ! Get the face index bounds
                h_iStart = BCData(nn)%icBeg
                h_iEnd = BCData(nn)%icEnd
                h_jStart = BCData(nn)%jcBeg
                h_jEnd = BCData(nn)%jcEnd
                h_iSize = h_iEnd - h_iStart + 1
                h_jSize = h_jEnd - h_jStart + 1

                ! Execute the routine on GPU
                call bcEulerWall<<<grid_size, block_size>>>(nn, BCFaceID(nn), &
                    h_iStart, h_jStart, h_iEnd, h_jEnd, h_iSize, h_jSize, secondHalo, correctForK)
                ! istat = cudaDeviceSynchronize()
            end if
        end do
!
!        ! ! ------------------------------------
!        ! !  Supersonic inflow condition
!        ! ! ------------------------------------
!        ! do nn = 1, nBocos
!        !     if (BCType(nn) == SupersonicInflow) then
!        !         call setBCPointers(nn, .False.)
!        !         call bcSupersonicInflow(nn, secondHalo, correctForK)
!        !     end if
!        ! end do
!
    end subroutine applyAllBC_block

    ! 
    !   Actual CUDA implementation of each of the boundary condition routines
    ! 

    attributes(global) subroutine bcSymm1stHalo(nn, faceID, iStart, jStart, iSize, jSize)
        !
        !       CUDA kernel for applying the symmetry boundary condition to the
        !       first halo of a block. 
        !
        use constants
        use cudaflowVarRefState, only: viscous, eddyModel
        use cudaBCPointers, only: faceLayerIndices
        implicit none

        !
        !       Subroutine arguments
        !
        integer(kind=intType), intent(in), value :: nn, faceID, iStart, jStart, iSize, jSize

        !
        !       Local variables
        !
        integer(kind=intType) :: dm = 1, sps = 1 ! Hardcoded to single block for now
        integer(kind=intType) :: i, j
        integer(kind=intType) :: I1, J1, K1, I2, J2, K2
        real(kind=realType) :: vn

        !
        ! Initialize GPU thread indices
        !
        i = (blockIdx%x-1)*blockDim%x + threadIdx%x + iStart - 1 ! starts at 0 + iStart
        j = (blockIdx%y-1)*blockDim%y + threadIdx%y + jStart - 1 ! starts at 0 + jStart

        if (((i - iStart) .lt. isize) .and. ((j - jStart) .lt. jsize)) then
            call faceLayerIndices(faceID, 1, i, j, dm, sps, I1, J1, K1) ! 1st halo
            call faceLayerIndices(faceID, 2, i, j, dm, sps, I2, J2, K2) ! 1st interior

            ! Determine twice the normal velocity component,
            ! which must be substracted from the donor velocity
            ! to obtain the halo velocity.
            vn = two * (cudaDoms(dm,sps)%w(I2, J2, K2, ivx) * BCData(nn)%norm(i, j, 1) + &
                        cudaDoms(dm,sps)%w(I2, J2, K2, ivy) * BCData(nn)%norm(i, j, 2) + &
                        cudaDoms(dm,sps)%w(I2, J2, K2, ivz) * BCData(nn)%norm(i, j, 3))

            ! Determine the flow variables in the halo cell.
            cudaDoms(dm,sps)%w(I1, J1, K1, irho) = cudaDoms(dm,sps)%w(I2, J2, K2, irho)
            cudaDoms(dm,sps)%w(I1, J1, K1, ivx) = cudaDoms(dm,sps)%w(I2, J2, K2, ivx) - vn * BCData(nn)%norm(i, j, 1)
            cudaDoms(dm,sps)%w(I1, J1, K1, ivy) = cudaDoms(dm,sps)%w(I2, J2, K2, ivy) - vn * BCData(nn)%norm(i, j, 2)
            cudaDoms(dm,sps)%w(I1, J1, K1, ivz) = cudaDoms(dm,sps)%w(I2, J2, K2, ivz) - vn * BCData(nn)%norm(i, j, 3)
            cudaDoms(dm,sps)%w(I1, J1, K1, irhoE) = cudaDoms(dm,sps)%w(I2, J2, K2, irhoE)

            ! Set the pressure and gamma and possibly the
            ! laminar and eddy viscosity in the halo.
            cudaDoms(dm,sps)%gamma(I1, J1, K1) = cudaDoms(dm,sps)%gamma(I2, J2, K2)
            cudaDoms(dm,sps)%P(I1, J1, K1) = cudaDoms(dm,sps)%P(I2, J2, K2)
            if (viscous) cudaDoms(dm,sps)%rlv(I1, J1, K1) = cudaDoms(dm,sps)%rlv(I2, J2, K2)
            if (eddyModel) cudaDoms(dm,sps)%rev(I1, J1, K1) = cudaDoms(dm,sps)%rev(I2, J2, K2)
        end if
    end subroutine bcSymm1stHalo

    attributes(global) subroutine bcSymm2ndHalo(nn, faceID, iStart, jStart, iSize, jSize)
        !
        !       CUDA kernel for applying the symmetry boundary condition to the
        !       SECOND halo of a block. The routine was split into two for AD purposes.
        !
        !
        use constants
        use cudaflowVarRefState, only: viscous, eddyModel
        use cudaBCPointers, only: faceLayerIndices
        implicit none

        !
        !       Subroutine arguments
        !
        integer(kind=intType), intent(in), value :: nn, faceID, iStart, jStart, iSize, jSize

        !
        !       Local variables
        !
        integer(kind=intType), parameter :: dm = 1, sps = 1 ! single-block/single-spectral harness
        integer(kind=intType) :: i, j
        integer(kind=intType) :: I0, J0, K0, I3, J3, K3
        real(kind=realType) :: vn

        !
        ! Initialize GPU thread indices
        !
        i = (blockIdx%x-1)*blockDim%x + threadIdx%x + iStart - 1 ! starts at 0 + iStart
        j = (blockIdx%y-1)*blockDim%y + threadIdx%y + jStart - 1 ! starts at 0 + jStart

        if (((i - iStart) .lt. isize) .and. ((j - jStart) .lt. jsize)) then
            call faceLayerIndices(faceID, 0, i, j, dm, sps, I0, J0, K0) ! 2nd/outermost halo
            call faceLayerIndices(faceID, 3, i, j, dm, sps, I3, J3, K3) ! 2nd interior

            ! Determine twice the normal velocity component,
            ! which must be substracted from the donor velocity
            ! to obtain the halo velocity.
            vn = two * (cudaDoms(dm,sps)%w(I3, J3, K3, ivx) * BCData(nn)%norm(i, j, 1) + &
                        cudaDoms(dm,sps)%w(I3, J3, K3, ivy) * BCData(nn)%norm(i, j, 2) + &
                        cudaDoms(dm,sps)%w(I3, J3, K3, ivz) * BCData(nn)%norm(i, j, 3))

            ! Determine the flow variables in the halo cell.
            cudaDoms(dm,sps)%w(I0, J0, K0, irho) = cudaDoms(dm,sps)%w(I3, J3, K3, irho)
            cudaDoms(dm,sps)%w(I0, J0, K0, ivx) = cudaDoms(dm,sps)%w(I3, J3, K3, ivx) - vn * BCData(nn)%norm(i, j, 1)
            cudaDoms(dm,sps)%w(I0, J0, K0, ivy) = cudaDoms(dm,sps)%w(I3, J3, K3, ivy) - vn * BCData(nn)%norm(i, j, 2)
            cudaDoms(dm,sps)%w(I0, J0, K0, ivz) = cudaDoms(dm,sps)%w(I3, J3, K3, ivz) - vn * BCData(nn)%norm(i, j, 3)
            cudaDoms(dm,sps)%w(I0, J0, K0, irhoE) = cudaDoms(dm,sps)%w(I3, J3, K3, irhoE)

            ! Set the pressure and gamma and possibly the
            ! laminar and eddy viscosity in the halo.
            cudaDoms(dm,sps)%gamma(I0, J0, K0) = cudaDoms(dm,sps)%gamma(I3, J3, K3)
            cudaDoms(dm,sps)%P(I0, J0, K0) = cudaDoms(dm,sps)%P(I3, J3, K3)
            if (viscous) cudaDoms(dm,sps)%rlv(I0, J0, K0) = cudaDoms(dm,sps)%rlv(I3, J3, K3)
            if (eddyModel) cudaDoms(dm,sps)%rev(I0, J0, K0) = cudaDoms(dm,sps)%rev(I3, J3, K3)
        end if

    end subroutine bcSymm2ndHalo

   ! subroutine bcSymmPolar1stHalo(nn)

   !     ! bcSymmPolar applies the polar symmetry boundary conditions to a
   !     ! singular line of a block. It is assumed that the pointers in
   !     ! blockPointers are already set to the correct block on the
   !     ! correct grid level.  The polar symmetry condition is a special
   !     ! case of a degenerate line, as this line is the axi-symmetric
   !     ! centerline. This routine does just the 1st level halo.

   !     use constants
   !     use BCPointers, only: ww1, ww2, pp1, pp2, rlv1, rlv2, rev1, rev2, &
   !                           xx, iStart, jStart, iSize, jSize
   !     use flowVarRefState, only: viscous, eddyModel
   !     implicit none

   !     ! Subroutine arguments.
   !     integer(kind=intType), intent(in) :: nn

   !     ! Local variables.
   !     integer(kind=intType) :: i, j, l, ii, mm
   !     real(kind=realType) :: nnx, nny, nnz, tmp, vtx, vty, vtz

   !     ! Loop over the generic subface to set the state in the
   !     ! 1-st level halos
   !     !$AD II-LOOP
   !     do ii = 0, isize * jsize - 1
   !         i = mod(ii, isize) + iStart
   !         j = ii / isize + jStart

   !         ! Determine the unit vector along the degenerated face.
   !         ! However it is not known which is the singular
   !         ! direction and therefore determine the direction along
   !         ! the diagonal (i,j) -- (i-1,j-1), which is correct for
   !         ! both singular i and j-direction. Note that due to the
   !         ! usage of the pointer xx there is an offset of +1
   !         ! in the indices and therefore (i+1,j+1) - (i,j) must
   !         ! be used to determine this vector.

   !         nnx = xx(i + 1, j + 1, 1) - xx(i, j, 1)
   !         nny = xx(i + 1, j + 1, 2) - xx(i, j, 2)
   !         nnz = xx(i + 1, j + 1, 3) - xx(i, j, 3)

   !         ! Determine the unit vector in this direction.

   !         tmp = one / sqrt(nnx * nnx + nny * nny + nnz * nnz)
   !         nnx = nnx * tmp
   !         nny = nny * tmp
   !         nnz = nnz * tmp

   !         ! Determine twice the tangential velocity vector of the
   !         ! internal cell.

   !         tmp = two * (ww2(i, j, ivx) * nnx + ww2(i, j, ivy) * nny &
   !                      + ww2(i, j, ivz) * nnz)
   !         vtx = tmp * nnx
   !         vty = tmp * nny
   !         vtz = tmp * nnz

   !         ! Determine the flow variables in the halo cell. The
   !         ! velocity is constructed such that the average of the
   !         ! internal and the halo cell is along the centerline.
   !         ! Note that the magnitude of the velocity does not
   !         ! change and thus the energy is identical.

   !         ww1(i, j, irho) = ww2(i, j, irho)
   !         ww1(i, j, ivx) = vtx - ww2(i, j, ivx)
   !         ww1(i, j, ivy) = vty - ww2(i, j, ivy)
   !         ww1(i, j, ivz) = vtz - ww2(i, j, ivz)
   !         ww1(i, j, irhoE) = ww2(i, j, irhoE)

   !         ! Set the pressure and possibly the laminar and
   !         ! eddy viscosity in the halo.

   !         pp1(i, j) = pp2(i, j)
   !         if (viscous) rlv1(i, j) = rlv2(i, j)
   !         if (eddyModel) rev1(i, j) = rev2(i, j)
   !     end do
   ! end subroutine bcSymmPolar1stHalo

   ! subroutine bcSymmPolar2ndHalo(nn)

   !     ! bcSymmPolar applies the polar symmetry boundary conditions to a
   !     ! singular line of a block. It is assumed that the pointers in
   !     ! blockPointers are already set to the correct block on the
   !     ! correct grid level.  The polar symmetry condition is a special
   !     ! case of a degenerate line, as this line is the axi-symmetric
   !     ! centerline. This routine does just the 2nd level halo.

   !     use constants
   !     use BCPointers, only: ww0, ww3, pp0, pp3, rlv0, rlv3, rev0, rev3, &
   !                           xx, iStart, jStart, iSize, jSize
   !     use flowVarRefState, only: viscous, eddyModel
   !     implicit none

   !     ! Subroutine arguments.
   !     integer(kind=intType), intent(in) :: nn

   !     ! Local variables.
   !     integer(kind=intType) :: i, j, l, ii, mm
   !     real(kind=realType) :: nnx, nny, nnz, tmp, vtx, vty, vtz

   !     !$AD II-LOOP
   !     do ii = 0, isize * jsize - 1
   !         i = mod(ii, isize) + iStart
   !         j = ii / isize + jStart

   !         ! Determine the unit vector along the degenerated face.
   !         ! However it is not known which is the singular
   !         ! direction and therefore determine the direction along
   !         ! the diagonal (i,j) -- (i-1,j-1), which is correct for
   !         ! both singular i and j-direction. Note that due to the
   !         ! usage of the pointer xx there is an offset of +1
   !         ! in the indices and therefore (i+1,j+1) - (i,j) must
   !         ! be used to determine this vector.

   !         nnx = xx(i + 1, j + 1, 1) - xx(i, j, 1)
   !         nny = xx(i + 1, j + 1, 2) - xx(i, j, 2)
   !         nnz = xx(i + 1, j + 1, 3) - xx(i, j, 3)

   !         ! Determine the unit vector in this direction.

   !         tmp = one / sqrt(nnx * nnx + nny * nny + nnz * nnz)
   !         nnx = nnx * tmp
   !         nny = nny * tmp
   !         nnz = nnz * tmp

   !         ! Determine twice the tangential velocity vector of the
   !         ! internal cell.

   !         tmp = two * (ww3(i, j, ivx) * nnx + ww3(i, j, ivy) * nny &
   !                      + ww3(i, j, ivz) * nnz)
   !         vtx = tmp * nnx
   !         vty = tmp * nny
   !         vtz = tmp * nnz

   !         ! Determine the flow variables in the halo cell. The
   !         ! velocity is constructed such that the average of the
   !         ! internal and the halo cell is along the centerline.
   !         ! Note that the magnitude of the velocity does not
   !         ! change and thus the energy is identical.

   !         ww0(i, j, irho) = ww3(i, j, irho)
   !         ww0(i, j, ivx) = vtx - ww3(i, j, ivx)
   !         ww0(i, j, ivy) = vty - ww3(i, j, ivy)
   !         ww0(i, j, ivz) = vtz - ww3(i, j, ivz)
   !         ww0(i, j, irhoE) = ww3(i, j, irhoE)

   !         ! Set the pressure and possibly the laminar and
   !         ! eddy viscosity in the halo.

   !         pp0(i, j) = pp3(i, j)
   !         if (viscous) rlv0(i, j) = rlv3(i, j)
   !         if (eddyModel) rev0(i, j) = rev3(i, j)
   !     end do

   ! end subroutine bcSymmPolar2ndHalo

    attributes(global) subroutine bcFarfield(nn, faceID, iStart, jStart, iSize, jSize, secondHalo, correctForK)
        !
        !       CUDA kernel for applying the farfield boundary condition to a block.
        !
        use constants
        use cudaFlowVarRefState, only: eddyModel, viscous, gammaInf, wInf, pInfCorr
        use cudaBCPointers, only: faceLayerIndices
        implicit none

        !
        !       Subroutine arguments
        !
        logical, intent(in), value :: secondHalo, correctForK
        integer, intent(in), value :: nn, faceID, iStart, jStart, iSize, jSize

        !
        !       Local variables
        !
        integer(kind=intType), parameter :: dm = 1, sps = 1 ! single-block/single-spectral harness
        integer(kind=intType) :: i, j
        integer(kind=intType) :: I1, J1, K1, I2, J2, K2

        real(kind=realType) :: gm1, ovgm1, ac1, ac2
        real(kind=realType) :: r0, u0, v0, w0, qn0, vn0, c0, s0
        real(kind=realType) :: re, ue, ve, we, qne, ce
        real(kind=realType) :: qnf, cf, uf, vf, wf, sf, cc, qq

        !
        ! Some constants needed to compute the riemann inVariants.
        !
        gm1 = gammaInf - one
        ovgm1 = one / gm1

        !
        ! Compute the three velocity components, the speed of sound and
        ! the entropy of the free stream.
        !
        r0 = one / wInf(irho)
        u0 = wInf(ivx)
        v0 = wInf(ivy)
        w0 = wInf(ivz)
        c0 = sqrt(gammaInf * pInfCorr * r0)
        s0 = wInf(irho)**gammaInf / pInfCorr

        !
        ! Initialize GPU thread indices
        !
        i = (blockIdx%x-1)*blockDim%x + threadIdx%x + iStart - 1 ! starts at 0 + iStart
        j = (blockIdx%y-1)*blockDim%y + threadIdx%y + jStart - 1 ! starts at 0 + jStart

        if (((i - iStart) .lt. isize) .and. ((j - jStart) .lt. jsize)) then
            call faceLayerIndices(faceID, 1, i, j, dm, sps, I1, J1, K1) ! 1st halo
            call faceLayerIndices(faceID, 2, i, j, dm, sps, I2, J2, K2) ! 1st interior

            ! Compute the normal velocity of the free stream and
            ! substract the normal velocity of the mesh.
            qn0 = u0 * BCData(nn)%norm(i, j, 1) + v0 * BCData(nn)%norm(i, j, 2) + w0 * BCData(nn)%norm(i, j, 3)
            vn0 = qn0 - BCData(nn)%rface(i, j)

            ! Compute the three velocity components, the normal
            ! velocity and the speed of sound of the current state
            ! in the internal cell.
            re = one / cudaDoms(dm,sps)%w(I2, J2, K2, irho)
            ue = cudaDoms(dm,sps)%w(I2, J2, K2, ivx)
            ve = cudaDoms(dm,sps)%w(I2, J2, K2, ivy)
            we = cudaDoms(dm,sps)%w(I2, J2, K2, ivz)
            qne = ue * BCData(nn)%norm(i, j, 1) + ve * BCData(nn)%norm(i, j, 2) + we * BCData(nn)%norm(i, j, 3)
            ce = sqrt(cudaDoms(dm,sps)%gamma(I2, J2, K2) * cudaDoms(dm,sps)%P(I2, J2, K2) * re)

            ! Compute the new values of the riemann inVariants in
            ! the halo cell. Either the value in the internal cell
            ! is taken (positive sign of the corresponding
            ! eigenvalue) or the free stream value is taken
            ! (otherwise).
            if (vn0 .gt. -c0) then ! Outflow or subsonic inflow.
                ac1 = qne + two * ovgm1 * ce
            else               ! Supersonic inflow.
                ac1 = qn0 + two * ovgm1 * c0
            end if

            if (vn0 .gt. c0) then  ! Supersonic outflow.
                ac2 = qne - two * ovgm1 * ce
            else                     ! Inflow or subsonic outflow.
                ac2 = qn0 - two * ovgm1 * c0
            end if

            qnf = half * (ac1 + ac2)
            cf = fourth * (ac1 - ac2) * gm1

            if (vn0 .gt. zero) then ! Outflow.

                uf = ue + (qnf - qne) * BCData(nn)%norm(i, j, 1)
                vf = ve + (qnf - qne) * BCData(nn)%norm(i, j, 2)
                wf = we + (qnf - qne) * BCData(nn)%norm(i, j, 3)

                sf = cudaDoms(dm,sps)%w(I2, J2, K2, irho)**cudaDoms(dm,sps)%gamma(I2, J2, K2) &
                     / cudaDoms(dm,sps)%P(I2, J2, K2)
            else
                ! Inflow
                uf = u0 + (qnf - qn0) * BCData(nn)%norm(i, j, 1)
                vf = v0 + (qnf - qn0) * BCData(nn)%norm(i, j, 2)
                wf = w0 + (qnf - qn0) * BCData(nn)%norm(i, j, 3)
                sf = s0
            end if

            ! Compute the density, velocity and pressure in the
            ! halo cell.
            cc = cf * cf / cudaDoms(dm,sps)%gamma(I2, J2, K2)
            qq = uf * uf + vf * vf + wf * wf
            cudaDoms(dm,sps)%w(I1, J1, K1, irho) = (sf * cc)**ovgm1
            cudaDoms(dm,sps)%w(I1, J1, K1, ivx) = uf
            cudaDoms(dm,sps)%w(I1, J1, K1, ivy) = vf
            cudaDoms(dm,sps)%w(I1, J1, K1, ivz) = wf
            cudaDoms(dm,sps)%P(I1, J1, K1) = cudaDoms(dm,sps)%w(I1, J1, K1, irho) * cc

            ! Simply set the laminar and eddy viscosity to
            ! the value in the donor cell. Their values do
            ! not matter too much in the far field.
            if (viscous) cudaDoms(dm,sps)%rlv(I1, J1, K1) = cudaDoms(dm,sps)%rlv(I2, J2, K2)
            if (eddyModel) cudaDoms(dm,sps)%rev(I1, J1, K1) = cudaDoms(dm,sps)%rev(I2, J2, K2)
        end if

        ! Compute the energy for these halos.
        call computeEtotHalo(faceID, iStart, jStart, iSize, jSize, 1_intType, correctForK)

        ! Extrapolate the state vectors in case a second halo
        ! is needed.
        if (secondHalo) call extrapolate2ndHalo(faceID, iStart, jStart, iSize, jSize, correctForK)

    end subroutine bcFarfield
!
    attributes(global) subroutine bcNSWallAdiabatic(nn, faceID, iStart, jStart, iSize, jSize, secondHalo, correctForK)
        !
        !       CUDA kernel that applies the viscous adiabatic wall boundary
        !       condition.
        !
        use constants
        use cudaBCPointers, only: faceLayerIndices
        use cudaflowVarRefState, only: viscous, eddyModel
        use cudaInputDiscretization, only: viscWallBCTreatment
        use cudaIteration, only: currentLevel, groundLevel
        implicit none

        !
        !       Subroutine arguments
        !
        logical, intent(in), value :: secondHalo, correctForK
        integer(kind=intType), intent(in), value :: nn, faceID, iStart, jStart, iSize, jSize

        !
        !       Local variables
        !
        integer(kind=intType), parameter :: dm = 1, sps = 1 ! single-block/single-spectral harness
        real(kind=realType) :: rhok
        integer(kind=intType) :: wallTreatment
        integer(kind=intType) :: i, j
        integer(kind=intType) :: I1, J1, K1, I2, J2, K2, I3, J3, K3

        !
        ! Initialize rhok to zero. This will be overwritten if a
        ! correction for k must be applied.
        !

        rhok = zero

        !
        ! Initialize GPU thread indices
        !
        i = (blockIdx%x-1)*blockDim%x + threadIdx%x + iStart - 1 ! starts at 0 + iStart
        j = (blockIdx%y-1)*blockDim%y + threadIdx%y + jStart - 1 ! starts at 0 + jStart

        if (((i - iStart) .lt. isize) .and. ((j - jStart) .lt. jsize)) then
            call faceLayerIndices(faceID, 1, i, j, dm, sps, I1, J1, K1) ! 1st halo
            call faceLayerIndices(faceID, 2, i, j, dm, sps, I2, J2, K2) ! 1st interior
            call faceLayerIndices(faceID, 3, i, j, dm, sps, I3, J3, K3) ! 2nd interior

            ! Set the value of rhok if a correcton must be applied.
            ! It probably does not matter too much, because k is very
            ! small near the wall.
            if (correctForK) rhok = cudaDoms(dm,sps)%w(I2, J2, K2, irho) * cudaDoms(dm,sps)%w(I2, J2, K2, itu1)

            ! Determine the variables in the halo. As the spacing
            ! is very small a constant pressure boundary condition
            ! (except for the k correction) is okay. Take the slip
            ! velocity into account.
            cudaDoms(dm,sps)%w(I1, J1, K1, irho) = cudaDoms(dm,sps)%w(I2, J2, K2, irho)
            cudaDoms(dm,sps)%w(I1, J1, K1, ivx) = -cudaDoms(dm,sps)%w(I2, J2, K2, ivx) + two * BCData(nn)%uSlip(i, j, 1)
            cudaDoms(dm,sps)%w(I1, J1, K1, ivy) = -cudaDoms(dm,sps)%w(I2, J2, K2, ivy) + two * BCData(nn)%uSlip(i, j, 2)
            cudaDoms(dm,sps)%w(I1, J1, K1, ivz) = -cudaDoms(dm,sps)%w(I2, J2, K2, ivz) + two * BCData(nn)%uSlip(i, j, 3)

            ! Set the viscosities. There is no need to test for a
            ! viscous problem of course. The eddy viscosity is
            ! set to the negative value, as it should be zero on
            ! the wall.
            cudaDoms(dm,sps)%rlv(I1, J1, K1) = cudaDoms(dm,sps)%rlv(I2, J2, K2)
            if (eddyModel) cudaDoms(dm,sps)%rev(I1, J1, K1) = -cudaDoms(dm,sps)%rev(I2, J2, K2)

            ! Make sure that on the coarser grids the constant pressure
            ! boundary condition is used.
            wallTreatment = viscWallBcTreatment
            if (currentLevel .gt. groundLevel) wallTreatment = constantPressure

            BCTreatment: select case (wallTreatment)
                case (constantPressure)
                    ! Constant pressure. Set the gradient to zero.
                    cudaDoms(dm,sps)%P(I1, J1, K1) = cudaDoms(dm,sps)%P(I2, J2, K2) - four * third * rhok
                case default
                    cudaDoms(dm,sps)%P(I1, J1, K1) = 2 * cudaDoms(dm,sps)%P(I2, J2, K2) - cudaDoms(dm,sps)%P(I3, J3, K3)
                    ! Adjust value if pressure is negative
                    if (cudaDoms(dm,sps)%P(I1, J1, K1) .le. zero) &
                        cudaDoms(dm,sps)%P(I1, J1, K1) = cudaDoms(dm,sps)%P(I2, J2, K2)
            end select BCTreatment
        end if

        ! Compute the energy for these halo's.
        call computeEtotHalo(faceID, iStart, jStart, iSize, jSize, 1_intType, correctForK)

        ! Extrapolate the state vectors in case a second halo
        ! is needed.
        if (secondHalo) call extrapolate2ndHalo(faceID, iStart, jStart, iSize, jSize, correctForK)

    end subroutine bcNSWallAdiabatic

   ! subroutine bcNSWallIsoThermal(nn, secondHalo, correctForK)

   !     ! bcNSWallAdiabatic applies the viscous isothermal wall boundary
   !     ! condition to a block. It is assumed that the BCPointers are
   !     ! already set

   !     use constants
   !     use blockPointers, only: BCData
   !     use inputDiscretization, only: viscWallBCTreatment
   !     use BCPointers, only: ww0, ww1, ww2, rlv0, rlv1, rlv2, pp0, pp1, pp2, pp3, &
   !                           rev0, rev1, rev2, iStart, jStart, iSize, jSize
   !     use flowVarRefState, only: viscous, eddyModel, RGas
   !     use iteration, only: currentLevel, groundLevel
   !     implicit none

   !     ! Subroutine arguments.
   !     logical, intent(in) :: secondHalo, correctForK
   !     integer(kind=intType), intent(in) :: nn

   !     ! Local variables.
   !     integer(kind=intType) :: i, j, ii
   !     integer(kind=intType) :: wallTreatment
   !     real(kind=realType) :: rhok, t2, t1

   !     ! Initialize rhok to zero. This will be overwritten if a
   !     ! correction for k must be applied.

   !     rhok = zero

   !     ! Loop over the generic subface to set the state in the
   !     ! halo cells.

   !     !$AD II-LOOP
   !     do ii = 0, isize * jsize - 1
   !         i = mod(ii, isize) + iStart
   !         j = ii / isize + jStart

   !         ! Set the value of rhok if a correcton must be applied.
   !         ! It probably does not matter too much, because k is very
   !         ! small near the wall.

   !         if (correctForK) rhok = ww2(i, j, irho) * ww2(i, j, itu1)

   !         ! Compute the temperature in the internal cell and in the
   !         ! halo cell such that the average is the wall temperature.

   !         t2 = pp2(i, j) / (RGas * ww2(i, j, irho))
   !         t1 = two * bcData(nn)%TNS_Wall(i, j) - t2

   !         ! Make sure that t1 is within reasonable bounds. These
   !         ! bounds are such that the clipping is never active in the
   !         ! converged solution; it is only to avoid instabilities
   !         ! during the convergence.

   !         t1 = max(half * bcData(nn)%TNS_Wall(i, j), t1)
   !         t1 = min(two * bcData(nn)%TNS_Wall(i, j), t1)

   !         ! PRESSURE EXTRAPOLATION

   !         ! Make sure that on the coarser grids the constant pressure
   !         ! boundary condition is used.

   !         wallTreatment = viscWallBCTreatment
   !         if (currentLevel > groundLevel) wallTreatment = constantPressure

   !         BCTreatment:select case(wallTreatment)

   !         case (constantPressure)

   !         ! Constant pressure. Set the gradient to zero.
   !         pp1(i, j) = pp2(i, j) - four * third * rhok

   !         case default

   !         ! Linear extrapolation.
   !         i = mod(ii, isize) + iStart
   !         j = ii / isize + jStart

   !         pp1(i, j) = 2 * pp2(i, j) - pp3(i, j)
   !         ! Adjust value if pressure is negative
   !         if (pp1(i, j) .le. zero) pp1(i, j) = pp2(i, j)

   !         end select BCTreatment

   !         ! Determine the variables in the halo. As the spacing
   !         ! is very small a constant pressure boundary condition
   !         ! (except for the k correction) is okay. Take the slip
   !         ! velocity into account.

   !         ww1(i, j, irho) = pp1(i, j) / (RGas * t1)
   !         ww1(i, j, ivx) = -ww2(i, j, ivx) + two * bcData(nn)%uSlip(i, j, 1)
   !         ww1(i, j, ivy) = -ww2(i, j, ivy) + two * bcData(nn)%uSlip(i, j, 2)
   !         ww1(i, j, ivz) = -ww2(i, j, ivz) + two * bcData(nn)%uSlip(i, j, 3)

   !         ! Set the viscosities. There is no need to test for a
   !         ! viscous problem of course. The eddy viscosity is
   !         ! set to the negative value, as it should be zero on
   !         ! the wall.

   !         rlv1(i, j) = rlv2(i, j)
   !         if (eddyModel) rev1(i, j) = -rev2(i, j)
   !     end do

   !     ! Compute the energy for these halo's.

   !     call computeEtotHalo(ww1, pp1, correctForK)

   !     ! Extrapolate the state vectors in case a second halo
   !     ! is needed.

   !     if (secondHalo) call extrapolate2ndHalo(correctForK)

   ! end subroutine bcNSWallIsoThermal

!    attributes(global) subroutine bcSubsonicOutflow(nn, secondHalo, correctForK)
!        ! read the subroutine description in BCRoutines.f90

!        use constants
!        use cudaBlock, only: BCData
!        use cudaBCPointers, only: ww0, ww1, ww2, pp0, pp1, pp2, &
!                              rlv0, rlv1, rlv2, rev0, rev1, rev2, gamma2, &
!                              iSize, jSize, iStart, jStart
!        use cudaflowVarRefState, only: eddyModel, viscous
!        implicit none

!        ! Subroutine arguments.
!        logical, intent(in) :: secondHalo, correctForK
!        integer(kind=intType), intent(in) :: nn

!        ! Local variables.
!        integer(kind=intType) :: i, j, l, ii
!        real(kind=realType), parameter :: twothird = two * third
!        real(kind=realType) :: ovg, ovgm1, nnx, nny, nnz
!        real(kind=realType) :: pExit, pInt, r, a2, a, ac, ss
!        real(kind=realType) :: ue, ve, we, qne, qnh


!        !
!        ! Initialize GPU thread indices
!        !
!        i = (blockIdx%x-1)*blockDim%x + threadIdx%x + iStart - 1 ! starts at 0 + iStart
!        j = (blockIdx%y-1)*blockDim%y + threadIdx%y + jStart - 1 ! starts at 0 + jStart

!        if ((i - iStart) <= isize .and. (j - jStart) <= jsize) then

!            ! Store a couple of variables, such as the static
!            ! pressure and grid unit outward normal, a bit easier.

!            pExit = BCData(nn)%ps(i, j)

!            nnx = BCData(nn)%norm(i, j, 1)
!            nny = BCData(nn)%norm(i, j, 2)
!            nnz = BCData(nn)%norm(i, j, 3)

!            ! Abbreviate 1/gamma and 1/(gamma -1) a bit easier.

!            ovg = one / gamma2(i, j)
!            ovgm1 = one / (gamma2(i, j) - one)

!            ! Store the internal pressure and correct for the
!            ! possible presence of a k-equation.

!            pInt = pp2(i, j)
!            if (correctForK) &
!                pInt = pInt - twothird * ww2(i, j, irho) * ww2(i, j, itu1)

!            ! Compute the velocity components, the normal velocity
!            ! and the speed of sound for the internal cell.

!            r = one / ww2(i, j, irho)
!            a2 = gamma2(i, j) * pInt * r
!            a = sqrt(a2)
!            ue = ww2(i, j, ivx)
!            ve = ww2(i, j, ivy)
!            we = ww2(i, j, ivz)
!            qne = ue * nnx + ve * nny + we * nnz

!            ! Compute the entropy and the acoustic variable.
!            ! These riemann inVariants, as well as the tangential
!            ! velocity components, are extrapolated.

!            ss = pInt * (r**gamma2(i, j))
!            ac = qne + two * a * ovgm1

!            ! Compute the state in the halo.

!            ww1(i, j, irho) = (pExit / ss)**ovg
!            pp1(i, j) = pExit
!            a = sqrt(gamma2(i, j) * pExit / ww1(i, j, irho))
!            qnh = ac - two * a * ovgm1
!            ww1(i, j, ivx) = ue + (qnh - qne) * nnx
!            ww1(i, j, ivy) = ve + (qnh - qne) * nny
!            ww1(i, j, ivz) = we + (qnh - qne) * nnz

!            ! Correct the pressure if a k-equation is present.

!            if (correctForK) &
!                pp1(i, j) = pp1(i, j) &
!                            + twothird * ww1(i, j, irho) * ww1(i, j, itu1)

!            ! Set the viscosities in the halo to the viscosities
!            ! in the donor cell.

!            if (viscous) rlv1(i, j) = rlv2(i, j)
!            if (eddyModel) rev1(i, j) = rev2(i, j)

!        end if

!        ! Compute the energy for these halo's.

!        call computeEtotHalo(ww1, pp1, correctForK)

!        ! Extrapolate the state vectors in case a second halo is needed.

!        if (secondHalo) call extrapolate2ndHalo(correctForK)

!    end subroutine bcSubsonicOutflow


    attributes(global) subroutine bcEulerWall(nn, faceID, iStart, jStart, iEnd, jEnd, iSize, jSize, secondHalo, correctForK)
        !
        !       CUDA kernel that applies the inviscid wall boundary condition to a
        !       block.
        !       TODO: Grid motion is not supported
        !
        use constants
        use cudaflowVarRefState, only: viscous, eddyModel
        use cudaInputDiscretization, only: eulerWallBCTreatment
        use cudaBCPointers, only: faceLayerIndices, spatialFaceIndices
        use cudaIteration, only: currentLevel, groundLevel
        implicit none

        !
        !       Subroutine arguments
        !
        logical, intent(in), value :: secondHalo, correctForK
        integer(kind=intType), intent(in), value :: nn, faceID, iStart, jStart, iEnd, jEnd, iSize, jSize

        !
        !       Local variables
        !
        integer(kind=intType) :: j, k
        integer(kind=intType) :: jm1, jp1, km1, kp1
        integer(kind=intType) :: wallTreatment
        integer(kind=intType) :: I2, J2, K2, I3, J3, K3
        integer(kind=intType), parameter :: dm = 1, sps = 1 ! single-block/single-spectral harness

        real(kind=realType) :: sixa, siya, siza, sjxa, sjya, sjza
        real(kind=realType) :: skxa, skya, skza, a1, b1
        real(kind=realType) :: rxj, ryj, rzj, rxk, ryk, rzk
        real(kind=realType) :: dpj, dpk, ri, rj, rk, qj, qk, vn
        real(kind=realType) :: uux, uuy, uuz
        real(kind=realType) :: grad ! Making this a per thread scaler

        ! Make sure that on the coarser grids the constant pressure
        ! boundary condition is used.
        wallTreatment = eulerWallBcTreatment

        !
        ! Set wall treatment based on MG level
        !
        if (currentLevel > groundLevel) wallTreatment = constantPressure 

        !
        ! Initialize GPU thread indices
        !
        j = (blockIdx%x-1)*blockDim%x + threadIdx%x + iStart - 1 ! starts at 0 + iStart
        k = (blockIdx%y-1)*blockDim%y + threadIdx%y + jStart - 1 ! starts at 0 + jStart

        !
        !  Determine the boundary condition treatment and compute the
        !  undivided pressure gradient accordingly. This gradient is
        !  temporarily stored in the halo pressure.
        !
        BCTreatment: select case (wallTreatment)
            case (constantPressure)
                ! Constant pressure. Set the gradient to zero.
                grad = zero
            case (linExtrapolPressure)
                ! Linear extrapolation.
                if (((j - iStart) .lt. isize) .and. ((k - jStart) .lt. jsize)) then
                    call faceLayerIndices(faceID, 2, j, k, dm, sps, I2, J2, K2) ! 1st interior
                    call faceLayerIndices(faceID, 3, j, k, dm, sps, I3, J3, K3) ! 2nd interior
                    grad = cudaDoms(dm,sps)%P(I3, J3, K3) - cudaDoms(dm,sps)%P(I2, J2, K2)
                end if

            case (normalMomentum)
                !
                ! Pressure gradient is computed using the normal momentum
                ! equation. First set a couple of additional variables for
                ! the normals, depending on the block face. Note that the
                ! construction 1: should not be used in these pointers,
                ! because element 0 is needed. Consequently there will be
                ! an offset of 1 for these normals. This is commented in
                ! the code. For moving faces also the grid velocity of
                ! the 1st cell center from the wall is needed.
                !
                if (((j - iStart) .lt. isize) .and. ((k - jStart) .lt. jsize)) then
                    ! Store the indices j+1, j-1 a bit easier and make
                    ! sure that they do not exceed the range of the arrays.
                    km1 = k - 1; km1 = max(jStart, km1)
                    kp1 = k + 1; kp1 = min(jend, kp1)

                    ! Compute the scaling factor for the central difference
                    ! in the j-direction.
                    b1 = one / max(1_intType, (kp1 - km1))

                    ! The indices j+1 and j-1. Make sure that they
                    ! do not exceed the range of the arrays.
                    jm1 = j - 1; jm1 = max(iStart, jm1)
                    jp1 = j + 1; jp1 = min(iEnd, jp1)

                    ! Compute the scaling factor for the central
                    ! difference in the j-direction.
                    a1 = one / max(1_intType, (jp1 - jm1))

                    ! Compute (twice) the average normal in the generic i,
                    ! j and k-direction. Note that in j and k-direction
                    ! the average in the original indices should be taken
                    ! using j-1 and j (and k-1 and k). However due to the
                    ! usage of pointers ssj and ssk there is an offset in
                    ! the indices of 1 and therefore now the correct
                    ! average is obtained with the indices j and j+1
                    ! (k and k+1).
                    ! 
                    ! NOTE: On GPU we do not use pointers so we can use the regular indicies however this comment is kept here
                    ! to clarify any potentially confusing indexing difference between CPU and GPU

                    !
                    ! NOTE: The I2, J2, K2, and I3, J3, and K3 variables are reused here to reduce register pressure. 
                    ! Note they mean different things now
                    !

                    ! First do the i direction on the FACE (out of face)
                    call spatialFaceIndices(faceID, 1, j, k, dm, sps, I2, J2, K2)
                    if ((faceID .eq. iMax) .or. (faceID .eq. iMin)) then
                        sixa = two * cudaDoms(dm,sps)%sI(I2, J2, K2, 1)
                        siya = two * cudaDoms(dm,sps)%sI(I2, J2, K2, 2)
                        siza = two * cudaDoms(dm,sps)%sI(I2, J2, K2, 3)
                    else if ((faceID .eq. jMax) .or. (faceID .eq. jMin)) then
                        sixa = two * cudaDoms(dm,sps)%sJ(I2, J2, K2, 1)
                        siya = two * cudaDoms(dm,sps)%sJ(I2, J2, K2, 2)
                        siza = two * cudaDoms(dm,sps)%sJ(I2, J2, K2, 3)
                    else
                        sixa = two * cudaDoms(dm,sps)%sK(I2, J2, K2, 1)
                        siya = two * cudaDoms(dm,sps)%sK(I2, J2, K2, 2)
                        siza = two * cudaDoms(dm,sps)%sK(I2, J2, K2, 3)
                    end if

                    ! Now do the j direction on the FACE
                    call spatialFaceIndices(faceID, 2, j, k, dm, sps, I2, J2, K2)
                    call spatialFaceIndices(faceID, 2, j-1, k, dm, sps, I3, J3, K3) ! It's minus one now since we don't use pointers!
                    if ((faceID .eq. iMax) .or. (faceID .eq. iMin)) then
                        sjxa = cudaDoms(dm,sps)%sJ(I2, J2, K2, 1) + cudaDoms(dm,sps)%sJ(I3, J3, K3, 1)
                        sjya = cudaDoms(dm,sps)%sJ(I2, J2, K2, 2) + cudaDoms(dm,sps)%sJ(I3, J3, K3, 2)
                        sjza = cudaDoms(dm,sps)%sJ(I2, J2, K2, 3) + cudaDoms(dm,sps)%sJ(I3, J3, K3, 3)
                    else
                        sjxa = cudaDoms(dm,sps)%sI(I2, J2, K2, 1) + cudaDoms(dm,sps)%sI(I3, J3, K3, 1)
                        sjya = cudaDoms(dm,sps)%sI(I2, J2, K2, 2) + cudaDoms(dm,sps)%sI(I3, J3, K3, 2)
                        sjza = cudaDoms(dm,sps)%sI(I2, J2, K2, 3) + cudaDoms(dm,sps)%sI(I3, J3, K3, 3)
                    end if

                    ! Now do the k direction on the FACE
                    call spatialFaceIndices(faceID, 3, j, k, dm, sps, I2, J2, K2)
                    call spatialFaceIndices(faceID, 3, j, k-1, dm, sps, I3, J3, K3) ! It's minus one now since we don't use pointers!
                    if ((faceID .eq. kMax) .or. (faceID .eq. kMin)) then
                        skxa = cudaDoms(dm,sps)%sJ(I2, J2, K2, 1) + cudaDoms(dm,sps)%sJ(I3, J3, K3, 1)
                        skya = cudaDoms(dm,sps)%sJ(I2, J2, K2, 2) + cudaDoms(dm,sps)%sJ(I3, J3, K3, 2)
                        skza = cudaDoms(dm,sps)%sJ(I2, J2, K2, 3) + cudaDoms(dm,sps)%sJ(I3, J3, K3, 3)
                    else
                        skxa = cudaDoms(dm,sps)%sK(I2, J2, K2, 1) + cudaDoms(dm,sps)%sK(I3, J3, K3, 1)
                        skya = cudaDoms(dm,sps)%sK(I2, J2, K2, 2) + cudaDoms(dm,sps)%sK(I3, J3, K3, 2)
                        skza = cudaDoms(dm,sps)%sK(I2, J2, K2, 3) + cudaDoms(dm,sps)%sK(I3, J3, K3, 3)
                    end if

                    ! Compute the difference of the normal vector and
                    ! pressure in j and k-direction. As the indices are
                    ! restricted to the 1st halo-layer, the computation
                    ! of the internal halo values is not consistent;
                    ! however this is not really a problem, because these
                    ! values are overwritten in the communication pattern.
                    rxj = a1 * (BCData(nn)%norm(jp1, k, 1) - BCData(nn)%norm(jm1, k, 1))
                    ryj = a1 * (BCData(nn)%norm(jp1, k, 2) - BCData(nn)%norm(jm1, k, 2))
                    rzj = a1 * (BCData(nn)%norm(jp1, k, 3) - BCData(nn)%norm(jm1, k, 3))
                    call faceLayerIndices(faceID, 2, jp1, k, dm, sps, I2, J2, K2)
                    call faceLayerIndices(faceID, 2, jm1, k, dm, sps, I3, J3, K3)
                    dpj = a1 * (cudaDoms(dm,sps)%P(I2, J2, K2) - cudaDoms(dm,sps)%P(I3, J3, K3))

                    rxk = b1 * (BCData(nn)%norm(j, kp1, 1) - BCData(nn)%norm(j, km1, 1))
                    ryk = b1 * (BCData(nn)%norm(j, kp1, 2) - BCData(nn)%norm(j, km1, 2))
                    rzk = b1 * (BCData(nn)%norm(j, kp1, 3) - BCData(nn)%norm(j, km1, 3))
                    call faceLayerIndices(faceID, 2, j, kp1, dm, sps, I2, J2, K2)
                    call faceLayerIndices(faceID, 2, j, km1, dm, sps, I3, J3, K3)
                    dpk = b1 * (cudaDoms(dm,sps)%P(I2, J2, K2) - cudaDoms(dm,sps)%P(I3, J3, K3))

                    ! Compute the dot product between the unit vector
                    ! and the normal vectors in i, j and k-direction.
                    ri = BCData(nn)%norm(j, k, 1) * sixa + BCData(nn)%norm(j, k, 2) * siya &
                         + BCData(nn)%norm(j, k, 3) * siza
                    rj = BCData(nn)%norm(j, k, 1) * sjxa + BCData(nn)%norm(j, k, 2) * sjya &
                         + BCData(nn)%norm(j, k, 3) * sjza
                    rk = BCData(nn)%norm(j, k, 1) * skxa + BCData(nn)%norm(j, k, 2) * skya &
                         + BCData(nn)%norm(j, k, 3) * skza

                    ! Store the velocity components in uux, uuy and uuz and
                    ! subtract the mesh velocity if the face is moving.
                    call faceLayerIndices(faceID, 2, j, k, dm, sps, I2, J2, K2)
                    uux = cudaDoms(dm,sps)%w(I2, J2, K2, ivx)
                    uuy = cudaDoms(dm,sps)%w(I2, J2, K2, ivy)
                    uuz = cudaDoms(dm,sps)%w(I2, J2, K2, ivz)

                    ! TODO: Ignore for now
                    ! if (addGridVelocities) then
                    !     uux = uux - ss(j, k, 1)
                    !     uuy = uuy - ss(j, k, 2)
                    !     uuz = uuz - ss(j, k, 3)
                    ! end if

                    ! Compute the velocity components in j and
                    ! k-direction.
                    qj = uux * sjxa + uuy * sjya + uuz * sjza
                    qk = uux * skxa + uuy * skya + uuz * skza

                    ! Compute the pressure gradient, which is stored
                    ! in pp1. I'm not entirely sure whether this
                    ! formulation is correct for moving meshes. It could
                    ! be that an additional term is needed there.
                    grad = ((qj * (uux * rxj + uuy * ryj + uuz * rzj) &
                                   + qk * (uux * rxk + uuy * ryk + uuz * rzk)) &
                                  * cudaDoms(dm,sps)%w(I2, J2, K2, irho) - rj * dpj - rk * dpk) / ri
                end if
        end select BCTreatment

        !
        ! Now determine the state in the halo cells. Again loop over
        ! the cell range for this subface.
        !
        if (((j - iStart) .lt. isize) .and. ((k - jStart) .lt. jsize)) then
            call faceLayerIndices(faceID, 2, j, k, dm, sps, I2, J2, K2)
            call faceLayerIndices(faceID, 1, j, k, dm, sps, I3, J3, K3)

            ! Write to pressure in 1st halo. we only read from pressures in the 1st and 2nd interior so we
            ! can avoid a race condition on this write
            cudaDoms(dm,sps)%p(I3, J3, K3) = cudaMyDim(cudaDoms(dm,sps)%p(I2, J2, K2), grad)
            ! pp1(j, k) = cudaMyDim(d_cudaDoms(nn,sps)%p(I2, J2, K2), grad(j,k))

            vn = two * (BCData(nn)%rface(j, k) - &
                        cudaDoms(dm,sps)%w(I2, J2, K2, ivx) * BCData(nn)%norm(j, k, 1) - &
                        cudaDoms(dm,sps)%w(I2, J2, K2, ivy) * BCData(nn)%norm(j, k, 2) - &
                        cudaDoms(dm,sps)%w(I2, J2, K2, ivz) * BCData(nn)%norm(j, k, 3))

            cudaDoms(dm,sps)%w(I3, J3, K3, irho) = cudaDoms(dm,sps)%w(I2, J2, K2, irho)
            cudaDoms(dm,sps)%w(I3, J3, K3, ivx) = cudaDoms(dm,sps)%w(I2, J2, K2, ivx) &
              + vn * BCData(nn)%norm(j, k, 1)
            cudaDoms(dm,sps)%w(I3, J3, K3, ivy) = cudaDoms(dm,sps)%w(I2, J2, K2, ivy) &
              + vn * BCData(nn)%norm(j, k, 2)
            cudaDoms(dm,sps)%w(I3, J3, K3, ivz) = cudaDoms(dm,sps)%w(I2, J2, K2, ivz) &
              + vn * BCData(nn)%norm(j, k, 3)

            ! The laminar and eddy viscosity, if present.
            if (viscous) cudaDoms(dm,sps)%rlv(I3, J3, K3) = cudaDoms(dm,sps)%rlv(I2, J2, K2)
            if (eddyModel) cudaDoms(dm,sps)%rev(I3, J3, K3) = cudaDoms(dm,sps)%rev(I2, J2, K2)
        end if

        ! Compute the energy for these halo's.
        call computeEtotHalo(faceID, iStart, jStart, iSize, jSize, 1, correctForK)

        ! Extrapolate the state vectors in case a second halo
        ! is needed.
        if (secondHalo) call extrapolate2ndHalo(faceID, iStart, jStart, iSize, jSize, correctForK)

    end subroutine bcEulerWall

    ! 
    !   Device Helper Kernels
    ! 

    attributes(device) function cudaMyDim(x, y)
        !
        !       CUDA device version of myDim: returns max(x - y, 0)
        !
        use constants, only: zero

        !
        !       Function arguments
        !
        real(kind=realType), value :: x, y

        !
        !       Function result
        !
        real(kind=realType) :: cudaMyDim

        cudaMyDim = x - y
        if (cudaMyDim .lt. zero) then
            cudaMyDim = zero
        end if
    end function cudaMyDim

    attributes(device) subroutine computeEtotHalo(faceID, iStart, jStart, iSize, jSize, haloSlot, correctForK)
        !
        !       CUDA device kernel for total energy computation for halo cells on a subface
        !       TODO: Only implements the constant cpModel
        !
        !       haloSlot selects which layer to update: 0 -> layer 0 (2nd/outermost halo),
        !       1- > layer 1 (1st halo)
        !
        use constants, only: third, five, half, irho, ivx, ivy, ivz, irhoE, itu1, one
        use cudaInputPhysics, only: gammaConstant
        use cudaBCPointers, only: faceLayerIndices
        implicit none

        !
        !       Subroutine arguments
        !
        integer(kind=intType), value :: faceID, haloSlot, iSize, jSize, iStart, jStart
        logical, value :: correctForK

        !
        !       Local variables
        !
        integer(kind=intType), parameter :: dm = 1, sps = 1 ! single-block/single-spectral harness
        integer(kind=intType) :: i, j
        integer(kind=intType) :: I3, J3, K3
        real(kind=realType) :: ovgm1, factK

        ! Constant cp and thus constant gamma.
        ! Abbreviate 1/(gamma -1) a bit easier.
        ovgm1 = one / (gammaConstant - one)
        factK = ovgm1 * (five * third - gammaConstant)

        !
        ! Initialize GPU thread indices
        !
        i = (blockIdx%x-1)*blockDim%x + threadIdx%x + iStart - 1 ! starts at 0 + iStart
        j = (blockIdx%y-1)*blockDim%y + threadIdx%y + jStart - 1 ! starts at 0 + jStart

        if (((i - iStart) .lt. isize) .and. ((j - jStart) .lt. jsize)) then
            call faceLayerIndices(faceID, haloSlot, i, j, dm, sps, I3, J3, K3)

            if (.not. correctForK) then
                cudaDoms(dm,sps)%w(I3, J3, K3, iRhoE) = ovgm1 * cudaDoms(dm,sps)%P(I3, J3, K3) &
                                  + half * cudaDoms(dm,sps)%w(I3, J3, K3, irho) * ( &
                                      cudaDoms(dm,sps)%w(I3, J3, K3, ivx)**2 &
                                      + cudaDoms(dm,sps)%w(I3, J3, K3, ivy)**2 &
                                      + cudaDoms(dm,sps)%w(I3, J3, K3, ivz)**2)
            else
                cudaDoms(dm,sps)%w(I3, J3, K3, iRhoE) = ovgm1 * cudaDoms(dm,sps)%P(I3, J3, K3) &
                                  + half * cudaDoms(dm,sps)%w(I3, J3, K3, irho) * ( &
                                      cudaDoms(dm,sps)%w(I3, J3, K3, ivx)**2 &
                                      + cudaDoms(dm,sps)%w(I3, J3, K3, ivy)**2 &
                                      + cudaDoms(dm,sps)%w(I3, J3, K3, ivz)**2) &
                                  - factK * cudaDoms(dm,sps)%w(I3, J3, K3, irho) * cudaDoms(dm,sps)%w(I3, J3, K3, itu1)
            end if
        end if

        ! Including only constant cp for now
        ! Skipping cpTempCurveFits
    end subroutine computeEtotHalo

    attributes(device) subroutine extrapolate2ndHalo(faceID, iStart, jStart, iSize, jSize, correctForK)
        !
        !       CUDA device kernel to determine the states of the second layer
        !       halo cells for the given subface of the block.
        !
        use constants, only: irho, ivx, ivy, ivz, two
        use cudaBCPointers, only: faceLayerIndices
        use cudaFlowVarRefState, only: viscous, eddyModel
        implicit none

        !
        !       Subroutine arguments
        !
        integer(kind=intType), value :: faceID, iSize, jSize, iStart, jStart
        logical :: correctForK

        !
        !       Local variables
        !
        real(kind=realType), parameter :: factor = 0.5_realType
        integer(kind=intType), parameter :: dm = 1, sps = 1 ! single-block/single-spectral harness
        integer(kind=intType) :: i, j
        integer(kind=intType) :: I0, J0, K0, I1, J1, K1, I2, J2, K2

        !
        ! Initialize GPU thread indices
        !
        i = (blockIdx%x-1)*blockDim%x + threadIdx%x + iStart - 1 ! starts at 0 + iStart
        j = (blockIdx%y-1)*blockDim%y + threadIdx%y + jStart - 1 ! starts at 0 + jStart

        if (((i - iStart) .lt. isize) .and. ((j - jStart) .lt. jsize)) then
            call faceLayerIndices(faceID, 0, i, j, dm, sps, I0, J0, K0) ! 2nd/outermost halo
            call faceLayerIndices(faceID, 1, i, j, dm, sps, I1, J1, K1) ! 1st halo
            call faceLayerIndices(faceID, 2, i, j, dm, sps, I2, J2, K2) ! 1st interior

            ! Extrapolate the density, momentum and pressure.
            ! Make sure that a certain threshold is kept.
            cudaDoms(dm,sps)%w(I0, J0, K0, irho) = two * cudaDoms(dm,sps)%w(I1, J1, K1, irho) &
                                                     - cudaDoms(dm,sps)%w(I2, J2, K2, irho)
            cudaDoms(dm,sps)%w(I0, J0, K0, irho) = max(factor * cudaDoms(dm,sps)%w(I1, J1, K1, irho), &
                                                         cudaDoms(dm,sps)%w(I0, J0, K0, irho))

            cudaDoms(dm,sps)%w(I0, J0, K0, ivx) = two * cudaDoms(dm,sps)%w(I1, J1, K1, ivx) &
                                                    - cudaDoms(dm,sps)%w(I2, J2, K2, ivx)
            cudaDoms(dm,sps)%w(I0, J0, K0, ivy) = two * cudaDoms(dm,sps)%w(I1, J1, K1, ivy) &
                                                    - cudaDoms(dm,sps)%w(I2, J2, K2, ivy)
            cudaDoms(dm,sps)%w(I0, J0, K0, ivz) = two * cudaDoms(dm,sps)%w(I1, J1, K1, ivz) &
                                                    - cudaDoms(dm,sps)%w(I2, J2, K2, ivz)

            cudaDoms(dm,sps)%P(I0, J0, K0) = max(factor * cudaDoms(dm,sps)%P(I1, J1, K1), &
                                                   two * cudaDoms(dm,sps)%P(I1, J1, K1) - cudaDoms(dm,sps)%P(I2, J2, K2))

            ! The laminar and eddy viscosity, if present. These values
            ! are simply taken constant. Their values do not matter.
            if (viscous) cudaDoms(dm,sps)%rlv(I0, J0, K0) = cudaDoms(dm,sps)%rlv(I1, J1, K1)
            if (eddyModel) cudaDoms(dm,sps)%rev(I0, J0, K0) = cudaDoms(dm,sps)%rev(I1, J1, K1)
        end if

        ! Compute the energy for this halo range.
        call computeEtotHalo(faceID, iStart, jStart, iSize, jSize, 0_intType, correctForK)
    end subroutine extrapolate2ndHalo
end module cudaBCRoutines
