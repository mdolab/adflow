! @File    :   cudaDebug.cuf
! @Desc    :   This module contains the routines for debugging the CUDA residual computation against CPU reference

module cudaDebug
! --- ADflow modules to use ---
use precision, only: realType, intType, porType
use cudaBlock, only: cudaDoms=>d_cudaDoms, h_cudaDoms
use constants
! use cudaBCPointers
! --- CUDA FORTRAN module ---
use cudafor
implicit none

contains

subroutine debugCompareCudaData
    ! 
    !   Generated by Claude; hand corrections and improvements
    !
    ! One-stop debug report: pulls the GPU block mirror back to the host
    ! (copyCudaBlockToHost) and prints a field-by-field comparison against the CPU
    ! (blockPointers) reference for every quantity that cudaBlock.cuf copies to/from
    ! the device, including the boundary-condition input data staged by
    ! copyCudaBCDataToDevice. Call this after both the CPU and GPU residual have been
    ! evaluated for the same flow state so the two sides are actually comparable.
    use constants
    use blockPointers, only: bvolRef => volRef, bie => ie, bje => je, bke => ke, &
                                bil => il, bjl => jl, bkl => kl, &
                                bux => ux, buy => uy, buz => uz, &
                                bvx => vx, bvy => vy, bvz => vz, &
                                bwx => wx, bwy => wy, bwz => wz, &
                                bqx => qx, bqy => qy, bqz => qz, &
                                bdw => dw, bfw => fw, bw => w, &
                                bib => ib, bjb => jb, bkb => kb, &
                                bsI => sI, bsJ => sJ, bsK => sK, &
                                bvol => vol, baa => aa, bp => p, bgamma => gamma, &
                                bradi => radi, bradj => radj, bradk => radk, &
                                brlv => rlv, brev => rev, &
                                bx => x, bshockSensor => shockSensor, bd2wall => d2wall, &
                                biblank => iblank, bPorI => porI, bPorJ => porJ, bPorK => porK, &
                                bsFaceI => sFaceI, bsFaceJ => sFaceJ, bsFaceK => sFaceK, &
                                bdtl => dtl, brightHanded => rightHanded, &
                                bnx => nx, bny => ny, bnz => nz, &
                                bnSubface => nSubface, bn1to1 => n1to1, bnBocos => nBocos, &
                                bnViscBocos => nViscBocos, bBCData => BCData, bBCType => BCType

    use inputTimeSpectral, only: nTimeIntervalsSpectral
    use flowvarrefstate, only: nw, nwf, nt1, nt2, pInfCorr
    use utils, only: setPointers
    use flowutils, only: ballNodalGradients => allNodalGradients, &
                            bcomputeSpeedOfSoundSquared => computeSpeedOfSoundSquared
    use cudaBlock, only: copyCudaBlockToHost, h_BCData

    implicit none

    ! Local Variables
    integer(kind=intType) :: i, j, k, mm, dom, sps
    real(kind=realType) :: sslim

    ! GPU-mirror values copied back to the host (device->host happens on assignment
    ! from h_cudaDoms(dom,sps)%<field>, see copyCudaBlockToHost).
    real(kind=realType), dimension(:, :, :, :), allocatable :: g_w, g_x, g_sI, g_sJ, g_sK, g_dss
    real(kind=realType), dimension(:, :, :, :), allocatable :: g_dw, g_fw
    real(kind=realType), dimension(:, :, :), allocatable :: g_p, g_gamma, g_ss
    real(kind=realType), dimension(:, :, :), allocatable :: g_vol, g_volRef, g_aa, g_rlv, g_rev
    real(kind=realType), dimension(:, :, :), allocatable :: g_radI, g_radJ, g_radK, g_dtl, g_d2wall
    real(kind=realType), dimension(:, :, :), allocatable :: g_sFaceI, g_sFaceJ, g_sFaceK
    real(kind=realType), dimension(:, :, :), allocatable :: g_ux, g_uy, g_uz, g_vx, g_vy, g_vz
    real(kind=realType), dimension(:, :, :), allocatable :: g_wx, g_wy, g_wz, g_qx, g_qy, g_qz
    integer(kind=intType), dimension(:, :, :), allocatable :: g_iblank
    integer(kind=porType), dimension(:, :, :), allocatable :: g_porI, g_porJ, g_porK

    ! Manually recomputed CPU reference for dss (no persistent CPU array exists for it)
    real(kind=realType), dimension(:, :, :, :), allocatable :: cpu_dss

    ! BC input-data staging temporaries (shape depends on the subface, sized per-boco below)
    real(kind=realType), dimension(:, :), allocatable :: g_rface
    real(kind=realType), dimension(:, :, :), allocatable :: g_norm, g_rfaceALE

    ! Hard coded for now
    dom = 1
    sps = 1

    ! Point blockPointers at the same block/spectral instance the GPU mirror covers.
    call setPointers(dom, 1, sps)

    ! Bring the GPU block mirror descriptors back to the host; the actual array DATA is
    ! pulled over lazily below, whenever we assign a plain host array from
    ! h_cudaDoms(dom,sps)%<field>.
    call copyCudaBlockToHost

    ! Recompute the CPU references for the fields the residual kernels fill but that
    ! aren't simple copies of persistent CPU state.
    baa = zero
    call bcomputeSpeedOfSoundSquared
    call ballNodalGradients
    call computeRefShockSensorDebug

    print *, ''
    print '(A)', repeat('#', 78)
    print '(2X,"CUDA residual debug report -- domain=",I0,", spectral instance=",I0)', dom, sps
    print '(A)', repeat('#', 78)

    call banner('BLOCK METADATA')
    call reportScalarInt('nx', h_cudaDoms(dom, sps)%nx, bnx)
    call reportScalarInt('ny', h_cudaDoms(dom, sps)%ny, bny)
    call reportScalarInt('nz', h_cudaDoms(dom, sps)%nz, bnz)
    call reportScalarInt('il', h_cudaDoms(dom, sps)%il, bil)
    call reportScalarInt('jl', h_cudaDoms(dom, sps)%jl, bjl)
    call reportScalarInt('kl', h_cudaDoms(dom, sps)%kl, bkl)
    call reportScalarInt('ie', h_cudaDoms(dom, sps)%ie, bie)
    call reportScalarInt('je', h_cudaDoms(dom, sps)%je, bje)
    call reportScalarInt('ke', h_cudaDoms(dom, sps)%ke, bke)
    call reportScalarInt('ib', h_cudaDoms(dom, sps)%ib, bib)
    call reportScalarInt('jb', h_cudaDoms(dom, sps)%jb, bjb)
    call reportScalarInt('kb', h_cudaDoms(dom, sps)%kb, bkb)
    call reportScalarLogical('rightHanded', h_cudaDoms(dom, sps)%rightHanded, brightHanded)

    call banner('GRID COORDINATES (x)')
    allocate (g_x(0:bie, 0:bje, 0:bke, 3))
    g_x = h_cudaDoms(dom, sps)%x
    call reportR4('x', g_x, bx)
    deallocate (g_x)

    call banner('FLOW STATE (w, p, gamma, shock sensor scratch)')
    allocate (g_w(0:bib, 0:bjb, 0:bkb, 1:nw))
    g_w = h_cudaDoms(dom, sps)%w
    call reportR4('w', g_w, bw)
    deallocate (g_w)

    allocate (g_p(0:bib, 0:bjb, 0:bkb))
    g_p = h_cudaDoms(dom, sps)%p
    call reportR3('p', g_p, bp)
    deallocate (g_p)

    allocate (g_gamma(0:bib, 0:bjb, 0:bkb))
    g_gamma = h_cudaDoms(dom, sps)%gamma
    call reportR3('gamma', g_gamma, bgamma)
    deallocate (g_gamma)

    allocate (g_ss(0:bib, 0:bjb, 0:bkb))
    g_ss = h_cudaDoms(dom, sps)%ss
    ! NOTE: The real shock sensor used in the CPU code is not stored. we have to use the reference one to check
    call reportR3('ss (shockSensor)', g_ss, bshockSensor)
    deallocate (g_ss)

    call banner('CELL VOLUMES')
    allocate (g_vol(1:bie, 1:bje, 1:bke))
    g_vol = h_cudaDoms(dom, sps)%vol
    call reportR3('vol', g_vol, bvol(1:bie, 1:bje, 1:bke))
    deallocate (g_vol)

    allocate (g_volRef(2:bil, 2:bjl, 2:bkl))
    g_volRef = h_cudaDoms(dom, sps)%volRef
    call reportR3('volRef', g_volRef, bvolRef(2:bil, 2:bjl, 2:bkl))
    deallocate (g_volRef)

    call banner('SPEED OF SOUND SQUARED / VISCOSITY')
    allocate (g_aa(1:bie, 1:bje, 1:bke))
    g_aa = h_cudaDoms(dom, sps)%aa
    call reportR3('aa', g_aa, baa(1:bie, 1:bje, 1:bke))
    deallocate (g_aa)

    allocate (g_rlv(1:bie, 1:bje, 1:bke))
    g_rlv = h_cudaDoms(dom, sps)%rlv
    call reportR3('rlv', g_rlv, brlv(1:bie, 1:bje, 1:bke))
    deallocate (g_rlv)

    allocate (g_rev(1:bie, 1:bje, 1:bke))
    g_rev = h_cudaDoms(dom, sps)%rev
    call reportR3('rev', g_rev, brev(1:bie, 1:bje, 1:bke))
    deallocate (g_rev)

    call banner('SPECTRAL RADII / TIME STEP')
    allocate (g_radI(1:bie, 1:bje, 1:bke), g_radJ(1:bie, 1:bje, 1:bke), g_radK(1:bie, 1:bje, 1:bke))
    g_radI = h_cudaDoms(dom, sps)%radI
    g_radJ = h_cudaDoms(dom, sps)%radJ
    g_radK = h_cudaDoms(dom, sps)%radK
    call reportR3('radI', g_radI, bradi)
    call reportR3('radJ', g_radJ, bradj)
    call reportR3('radK', g_radK, bradk)
    deallocate (g_radI, g_radJ, g_radK)

    allocate (g_dtl(1:bie, 1:bje, 1:bke))
    g_dtl = h_cudaDoms(dom, sps)%dtl
    call reportR3('dtl', g_dtl, bdtl)
    deallocate (g_dtl)

    call banner('FACE PROJECTED AREAS (sI, sJ, sK)')
    allocate (g_sI(0:bie, 1:bje, 1:bke, 3), g_sJ(1:bie, 0:bje, 1:bke, 3), g_sK(1:bie, 1:bje, 0:bke, 3))
    g_sI = h_cudaDoms(dom, sps)%sI
    g_sJ = h_cudaDoms(dom, sps)%sJ
    g_sK = h_cudaDoms(dom, sps)%sK
    call reportR4('sI', g_sI, bsI)
    call reportR4('sJ', g_sJ, bsJ)
    call reportR4('sK', g_sK, bsK)
    deallocate (g_sI, g_sJ, g_sK)

    call banner('FACE VELOCITIES (sFaceI, sFaceJ, sFaceK)')
    allocate (g_sFaceI(0:bie, 1:bje, 1:bke), g_sFaceJ(1:bie, 0:bje, 1:bke), g_sFaceK(1:bie, 1:bje, 0:bke))
    g_sFaceI = h_cudaDoms(dom, sps)%sFaceI
    g_sFaceJ = h_cudaDoms(dom, sps)%sFaceJ
    g_sFaceK = h_cudaDoms(dom, sps)%sFaceK
    call reportR3('sFaceI', g_sFaceI, bsFaceI)
    call reportR3('sFaceJ', g_sFaceJ, bsFaceJ)
    call reportR3('sFaceK', g_sFaceK, bsFaceK)
    deallocate (g_sFaceI, g_sFaceJ, g_sFaceK)

    call banner('FACE POROSITIES (porI, porJ, porK)')
    allocate (g_porI(1:bil, 2:bjl, 2:bkl), g_porJ(2:bil, 1:bjl, 2:bkl), g_porK(2:bil, 2:bjl, 1:bkl))
    g_porI = int(h_cudaDoms(dom, sps)%porI, kind=porType)
    g_porJ = int(h_cudaDoms(dom, sps)%porJ, kind=porType)
    g_porK = int(h_cudaDoms(dom, sps)%porK, kind=porType)
    call reportPor('porI', g_porI, bPorI)
    call reportPor('porJ', g_porJ, bPorJ)
    call reportPor('porK', g_porK, bPorK)
    deallocate (g_porI, g_porJ, g_porK)

    call banner('CELL BLANKING / WALL DISTANCE')
    allocate (g_iblank(2:bil, 2:bjl, 2:bkl))
    g_iblank = h_cudaDoms(dom, sps)%iblank
    call reportI3('iblank', g_iblank, biblank(2:bil, 2:bjl, 2:bkl))
    deallocate (g_iblank)

    if (allocated(h_cudaDoms(dom, sps)%d2wall)) then
        allocate (g_d2wall(2:bil, 2:bjl, 2:bkl))
        g_d2wall = h_cudaDoms(dom, sps)%d2wall
        call reportR3('d2wall', g_d2wall, bd2wall)
        deallocate (g_d2wall)
    else
        call reportSkip('d2wall', 'not allocated on this run (RANS only)')
    end if

    call banner('NODAL GRADIENTS (ux..qz)')
    allocate (g_ux(1:bil, 1:bjl, 1:bkl), g_uy(1:bil, 1:bjl, 1:bkl), g_uz(1:bil, 1:bjl, 1:bkl))
    allocate (g_vx(1:bil, 1:bjl, 1:bkl), g_vy(1:bil, 1:bjl, 1:bkl), g_vz(1:bil, 1:bjl, 1:bkl))
    allocate (g_wx(1:bil, 1:bjl, 1:bkl), g_wy(1:bil, 1:bjl, 1:bkl), g_wz(1:bil, 1:bjl, 1:bkl))
    allocate (g_qx(1:bil, 1:bjl, 1:bkl), g_qy(1:bil, 1:bjl, 1:bkl), g_qz(1:bil, 1:bjl, 1:bkl))
    g_ux = h_cudaDoms(dom, sps)%ux; g_uy = h_cudaDoms(dom, sps)%uy; g_uz = h_cudaDoms(dom, sps)%uz
    g_vx = h_cudaDoms(dom, sps)%vx; g_vy = h_cudaDoms(dom, sps)%vy; g_vz = h_cudaDoms(dom, sps)%vz
    g_wx = h_cudaDoms(dom, sps)%wx; g_wy = h_cudaDoms(dom, sps)%wy; g_wz = h_cudaDoms(dom, sps)%wz
    g_qx = h_cudaDoms(dom, sps)%qx; g_qy = h_cudaDoms(dom, sps)%qy; g_qz = h_cudaDoms(dom, sps)%qz
    call reportR3('ux', g_ux, bux); call reportR3('uy', g_uy, buy); call reportR3('uz', g_uz, buz)
    call reportR3('vx', g_vx, bvx); call reportR3('vy', g_vy, bvy); call reportR3('vz', g_vz, bvz)
    call reportR3('wx', g_wx, bwx); call reportR3('wy', g_wy, bwy); call reportR3('wz', g_wz, bwz)
    call reportR3('qx', g_qx, bqx); call reportR3('qy', g_qy, bqy); call reportR3('qz', g_qz, bqz)
    deallocate (g_ux, g_uy, g_uz, g_vx, g_vy, g_vz, g_wx, g_wy, g_wz, g_qx, g_qy, g_qz)

    call banner('SHOCK SENSOR (dss) -- CPU reference recomputed reference shock sensor scratch, no persistent CPU array exists')
    allocate (g_dss(1:bie, 1:bje, 1:bke, 1:3))
    g_dss = h_cudaDoms(dom, sps)%dss
    allocate (cpu_dss(1:bie, 1:bje, 1:bke, 1:3))
    sslim = 0.001_realType * pInfCorr
    do k = 1, bke
        do j = 1, bje
            do i = 1, bie
                cpu_dss(i, j, k, 1) = abs((bshockSensor(i + 1, j, k) - two * bshockSensor(i, j, k) + bshockSensor(i - 1, j, k)) &
                                            / (bshockSensor(i + 1, j, k) + two * bshockSensor(i, j, k) + bshockSensor(i - 1, j, k) + sslim))

                cpu_dss(i, j, k, 2) = abs((bshockSensor(i, j + 1, k) - two * bshockSensor(i, j, k) + bshockSensor(i, j - 1, k)) &
                                            / (bshockSensor(i, j + 1, k) + two * bshockSensor(i, j, k) + bshockSensor(i, j - 1, k) + sslim))

                cpu_dss(i, j, k, 3) = abs((bshockSensor(i, j, k + 1) - two * bshockSensor(i, j, k) + bshockSensor(i, j, k - 1)) &
                                            / (bshockSensor(i, j, k + 1) + two * bshockSensor(i, j, k) + bshockSensor(i, j, k - 1) + sslim))
            end do
        end do
    end do
    call reportR4('dss', g_dss, cpu_dss)
    deallocate (g_dss, cpu_dss)

    call banner('RESIDUALS (dw, fw) -- interior cells only, 2:il,2:jl,2:kl')
    allocate (g_dw(1:bie, 1:bje, 1:bke, 1:nw))
    g_dw = h_cudaDoms(dom, sps)%dw
    call reportR4('dw', g_dw(2:bil, 2:bjl, 2:bkl, 1:nw), bdw(2:bil, 2:bjl, 2:bkl, 1:nw))
    deallocate (g_dw)

    allocate (g_fw(1:bie, 1:bje, 1:bke, 1:nwf))
    g_fw = h_cudaDoms(dom, sps)%fw
    call reportR4('fw', g_fw(2:bil, 2:bjl, 2:bkl, 1:nwf), bfw(2:bil, 2:bjl, 2:bkl, 1:nwf))
    deallocate (g_fw)

    call banner('BC METADATA')
    call reportScalarInt('nSubface', h_cudaDoms(dom, sps)%nSubface, bnSubface)
    call reportScalarInt('n1to1', h_cudaDoms(dom, sps)%n1to1, bn1to1)
    call reportScalarInt('nBocos', h_cudaDoms(dom, sps)%nBocos, bnBocos)
    call reportScalarInt('nViscBocos', h_cudaDoms(dom, sps)%nViscBocos, bnViscBocos)

    call banner('BC INPUT DATA STAGING (rface, norm, rfaceALE) -- farField/symm only, see note above')
    do mm = 1, bnBocos
        select case (bBCType(mm))

        case (farField)
            print '(2X,"boco ",I0,": farField, icBeg:icEnd=",I0,":",I0,", jcBeg:jcEnd=",I0,":",I0)', &
                mm, bBCData(mm)%icBeg, bBCData(mm)%icEnd, bBCData(mm)%jcBeg, bBCData(mm)%jcEnd

            allocate (g_rface(lbound(bBCData(mm)%rface, 1):ubound(bBCData(mm)%rface, 1), &
                                lbound(bBCData(mm)%rface, 2):ubound(bBCData(mm)%rface, 2)))
            g_rface = h_BCData(mm)%rface
            call reportR2('  rface', g_rface, bBCData(mm)%rface)
            deallocate (g_rface)

            allocate (g_norm(lbound(bBCData(mm)%norm, 1):ubound(bBCData(mm)%norm, 1), &
                                lbound(bBCData(mm)%norm, 2):ubound(bBCData(mm)%norm, 2), &
                                lbound(bBCData(mm)%norm, 3):ubound(bBCData(mm)%norm, 3)))
            g_norm = h_BCData(mm)%norm
            call reportR3('  norm', g_norm, bBCData(mm)%norm)
            deallocate (g_norm)

            allocate (g_rfaceALE(lbound(bBCData(mm)%rFaceALE, 1):ubound(bBCData(mm)%rFaceALE, 1), &
                                    lbound(bBCData(mm)%rFaceALE, 2):ubound(bBCData(mm)%rFaceALE, 2), &
                                    lbound(bBCData(mm)%rFaceALE, 3):ubound(bBCData(mm)%rFaceALE, 3)))
            g_rfaceALE = h_BCData(mm)%rfaceALE
            call reportR3('  rfaceALE', g_rfaceALE, bBCData(mm)%rFaceALE)
            deallocate (g_rfaceALE)

        case (symm)
            print '(2X,"boco ",I0,": symm, icBeg:icEnd=",I0,":",I0,", jcBeg:jcEnd=",I0,":",I0)', &
                mm, bBCData(mm)%icBeg, bBCData(mm)%icEnd, bBCData(mm)%jcBeg, bBCData(mm)%jcEnd

            allocate (g_norm(lbound(bBCData(mm)%norm, 1):ubound(bBCData(mm)%norm, 1), &
                                lbound(bBCData(mm)%norm, 2):ubound(bBCData(mm)%norm, 2), &
                                lbound(bBCData(mm)%norm, 3):ubound(bBCData(mm)%norm, 3)))
            g_norm = h_BCData(mm)%norm
            call reportR3('  norm', g_norm, bBCData(mm)%norm)
            deallocate (g_norm)

        case default
            call reportSkip('boco '//trim(itoa(mm)), 'BC type not mirrored to device, see allocateCudaBCData')

        end select
    end do

contains

    subroutine banner(title)
        character(len=*), intent(in) :: title
        print *, ''
        print '(A)', repeat('=', 78)
        print '(2X,A)', title
        print '(A)', repeat('=', 78)
    end subroutine banner

    function itoa(n) result(s)
        integer(kind=intType), intent(in) :: n
        character(len=12) :: s
        write (s, '(I0)') n
    end function itoa

    subroutine reportR2(name, g, c)
        character(len=*), intent(in) :: name
        real(kind=realType), dimension(:, :), intent(in) :: g, c
        real(kind=realType) :: maxDiff, sumDiff, maxCPU, relDiff
        integer(kind=intType) :: loc(2)

        if (any(shape(g) /= shape(c))) then
            print '(2X,A,T26,"SHAPE MISMATCH: gpu=",2(I0,1X)," cpu=",2(I0,1X))', trim(name), shape(g), shape(c)
            return
        end if

        maxDiff = maxval(abs(g - c))
        sumDiff = sum(abs(g - c))
        maxCPU = maxval(abs(c))
        relDiff = maxDiff / max(maxCPU, 1.0e-30_realType)
        loc = maxloc(abs(g - c))

        print '(2X,A,T26,"maxDiff=",ES13.6,2X,"sumDiff=",ES13.6,2X,"max|cpu|=",ES13.6,&
            &2X,"relDiff=",ES13.6,2X,"loc=(",I0,",",I0,")")', &
            trim(name), maxDiff, sumDiff, maxCPU, relDiff, loc(1), loc(2)
    end subroutine reportR2

    subroutine reportR3(name, g, c)
        character(len=*), intent(in) :: name
        real(kind=realType), dimension(:, :, :), intent(in) :: g, c
        real(kind=realType) :: maxDiff, sumDiff, maxCPU, relDiff
        integer(kind=intType) :: loc(3)

        if (any(shape(g) /= shape(c))) then
            print '(2X,A,T26,"SHAPE MISMATCH: gpu=",3(I0,1X)," cpu=",3(I0,1X))', trim(name), shape(g), shape(c)
            return
        end if

        maxDiff = maxval(abs(g - c))
        sumDiff = sum(abs(g - c))
        maxCPU = maxval(abs(c))
        relDiff = maxDiff / max(maxCPU, 1.0e-30_realType)
        loc = maxloc(abs(g - c))

        print '(2X,A,T26,"maxDiff=",ES13.6,2X,"sumDiff=",ES13.6,2X,"max|cpu|=",ES13.6,&
            &2X,"relDiff=",ES13.6,2X,"loc=(",I0,",",I0,",",I0,")")', &
            trim(name), maxDiff, sumDiff, maxCPU, relDiff, loc(1), loc(2), loc(3)
    end subroutine reportR3

    subroutine reportR4(name, g, c)
        character(len=*), intent(in) :: name
        real(kind=realType), dimension(:, :, :, :), intent(in) :: g, c
        real(kind=realType) :: maxDiff, sumDiff, maxCPU, relDiff
        integer(kind=intType) :: loc(4)

        if (any(shape(g) /= shape(c))) then
            print '(2X,A,T26,"SHAPE MISMATCH: gpu=",4(I0,1X)," cpu=",4(I0,1X))', trim(name), shape(g), shape(c)
            return
        end if

        maxDiff = maxval(abs(g - c))
        sumDiff = sum(abs(g - c))
        maxCPU = maxval(abs(c))
        relDiff = maxDiff / max(maxCPU, 1.0e-30_realType)
        loc = maxloc(abs(g - c))

        print '(2X,A,T26,"maxDiff=",ES13.6,2X,"sumDiff=",ES13.6,2X,"max|cpu|=",ES13.6,&
            &2X,"relDiff=",ES13.6,2X,"loc=(",I0,",",I0,",",I0,",",I0,")")', &
            trim(name), maxDiff, sumDiff, maxCPU, relDiff, loc(1), loc(2), loc(3), loc(4)
    end subroutine reportR4

    subroutine reportI3(name, g, c)
        character(len=*), intent(in) :: name
        integer(kind=intType), dimension(:, :, :), intent(in) :: g, c
        integer(kind=intType) :: maxDiff, sumDiff, loc(3)

        if (any(shape(g) /= shape(c))) then
            print '(2X,A,T26,"SHAPE MISMATCH: gpu=",3(I0,1X)," cpu=",3(I0,1X))', trim(name), shape(g), shape(c)
            return
        end if

        maxDiff = maxval(abs(g - c))
        sumDiff = sum(abs(g - c))
        loc = maxloc(abs(g - c))

        print '(2X,A,T26,"maxDiff=",I8,2X,"sumDiff=",I10,2X,"loc=(",I0,",",I0,",",I0,")")', &
            trim(name), maxDiff, sumDiff, loc(1), loc(2), loc(3)
    end subroutine reportI3


    subroutine reportPor(name, g, c)
        character(len=*), intent(in) :: name
        integer(kind=porType), dimension(:, :, :), intent(in) :: g, c
        integer(kind=intType) :: maxDiff, sumDiff, loc(3)

        if (any(shape(g) /= shape(c))) then
            print '(2X,A,T26,"SHAPE MISMATCH: gpu=",3(I0,1X)," cpu=",3(I0,1X))', trim(name), shape(g), shape(c)
            return
        end if

        maxDiff = maxval(abs(g - c))
        sumDiff = sum(abs(g - c))
        loc = maxloc(abs(g - c))

        print '(2X,A,T26,"maxDiff=",I8,2X,"sumDiff=",I10,2X,"loc=(",I0,",",I0,",",I0,")")', &
            trim(name), maxDiff, sumDiff, loc(1), loc(2), loc(3)
    end subroutine reportPor

    subroutine reportScalarInt(name, g, c)
        character(len=*), intent(in) :: name
        integer(kind=intType), intent(in) :: g, c

        if (g == c) then
            print '(2X,A,T26,"gpu=",I8,2X,"cpu=",I8,2X,"OK")', trim(name), g, c
        else
            print '(2X,A,T26,"gpu=",I8,2X,"cpu=",I8,2X,"MISMATCH")', trim(name), g, c
        end if
    end subroutine reportScalarInt

    subroutine reportScalarLogical(name, g, c)
        character(len=*), intent(in) :: name
        logical, intent(in) :: g, c

        if (g .eqv. c) then
            print '(2X,A,T26,"gpu=",L1,2X,"cpu=",L1,2X,"OK")', trim(name), g, c
        else
            print '(2X,A,T26,"gpu=",L1,2X,"cpu=",L1,2X,"MISMATCH")', trim(name), g, c
        end if
    end subroutine reportScalarLogical

    subroutine reportSkip(name, reason)
        character(len=*), intent(in) :: name, reason
        print '(2X,A,T26,"SKIPPED -- ",A)', trim(name), trim(reason)
    end subroutine reportSkip

end subroutine debugCompareCudaData



subroutine computeRefShockSensorDebug

    ! Populate the reference shock sensor for debugging purposes
    use constants
    use blockPointers, only: ib, jb, kb, shockSensor, &
                                w, gamma, p, nDom
    use inputTimeSpectral, only: nTimeIntervalsSpectral
    use inputPhysics, only: equations
    use inputDiscretization, only: spaceDiscr
    use utils, only: setPointers, EChk
    implicit none

    ! Working variables
    integer(kind=intType) :: nn, level, sps, i, j, k

    level = 1

    ! Hard code for now
    nn = 1
    sps = 1

    ! do nn = 1, nDom
    !     do sps = 1, nTimeIntervalsSpectral
            call setPointers(nn, level, sps)

            if (equations == EulerEquations .or. spaceDiscr == dissMatrix) then
                !shockSensor is Pressure
                do k = 0, kb
                    do j = 0, jb
                        do i = 0, ib
                            shockSensor(i, j, k) = P(i, j, k)
                        end do
                    end do
                end do
            else
                ! Entropy is used instead
                do k = 0, kb
                    do j = 0, jb
                        do i = 0, ib
                            shockSensor(i, j, k) = p(i, j, k) / (w(i, j, k, irho)**gamma(i, j, k))
                        end do
                    end do
                end do
            end if
    !     end do
    ! end do
end subroutine computeRefShockSensorDebug

end module cudaDebug