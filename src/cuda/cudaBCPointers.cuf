! @File    :   cudaBCPointers.cuf
! @Desc    :   CUDA Fortran version of BCPointers.F90 / utils::setBCPointers.

module cudaBCPointers
    !
    !       This module is complete rewrite of BCPointers for CUDA.
    !       The original CPU code BCPointers approach to slicing boundary cells
    !       from a block fundamentally doesn't work on GPU since pointers must target
    !       simply contiguous slices of an array which is never the case with boundary slices
    !       Instead we come up with a fundamentally new approach for getting the subface
    !       slices by instead converting a 2D index on a given face to the equivalent 3D index
    !       on the block
    !

    !
    !   ADflow modules
    !
    use constants, only: intType, realType
    use cudaBlock, only: cudaDoms => d_cudaDoms

    implicit none

contains

    attributes(device) subroutine faceLayerIndices(faceID, layer, i, j, dm, sps, I3, J3, K3)
        !
        !       Converts a face-local (i,j) position + "layer" (0=2nd/outermost halo, 1=1st halo,
        !       2=1st interior, 3=2nd interior) into the actual 3D cell index (I3,J3,K3) into
        !       block arrays, for the given boco face direction. Matches setBCPointers'
        !       per-face index arithmetic, computed per-thread instead of as
        !       a host-side pointer slice.
        !
        use constants, only: iMin, iMax, jMin, jMax, kMin, kMax
        implicit none

        !
        !       Subroutine arguments
        !
        integer(kind=intType), intent(in), value :: faceID, layer, i, j, dm, sps
        integer(kind=intType), intent(out) :: I3, J3, K3

        select case (faceID)
        case (iMin)
            I3 = layer  ! 0,1,2,3 map directly to the i-index for a Min face
            J3 = i
            K3 = j
        case (iMax)
            select case (layer)
            case (0); I3 = cudaDoms(dm,sps)%ib
            case (1); I3 = cudaDoms(dm,sps)%ie
            case (2); I3 = cudaDoms(dm,sps)%il
            case (3); I3 = cudaDoms(dm,sps)%nx
            end select
            J3 = i
            K3 = j
        case (jMin)
            I3 = i
            J3 = layer
            K3 = j
        case (jMax)
            I3 = i
            select case (layer)
            case (0); J3 = cudaDoms(dm,sps)%jb
            case (1); J3 = cudaDoms(dm,sps)%je
            case (2); J3 = cudaDoms(dm,sps)%jl
            case (3); J3 = cudaDoms(dm,sps)%ny
            end select
            K3 = j
        case (kMin)
            I3 = i
            J3 = j
            K3 = layer
        case (kMax)
            I3 = i
            J3 = j
            select case (layer)
            case (0); K3 = cudaDoms(dm,sps)%kb
            case (1); K3 = cudaDoms(dm,sps)%ke
            case (2); K3 = cudaDoms(dm,sps)%kl
            case (3); K3 = cudaDoms(dm,sps)%nz
            end select
        end select

    end subroutine faceLayerIndices

    attributes(device) subroutine spatialFaceIndices(faceID, dir, i, j, dm, sps, I3, J3, K3)
        !
        !       Converts a face-local (i,j) position + faceID into the i j k index needed to index
        !       into a per face array. Basically faceLayerIndices but for face quantities like normals
        !       instead of cell centered quantities
        !
        use constants, only: iMin, iMax, jMin, jMax, kMin, kMax
        implicit none

        !
        !       Subroutine arguments
        !
        integer(kind=intType), intent(in), value :: faceID, dir, i, j, dm, sps
        integer(kind=intType), intent(out) :: I3, J3, K3

        select case (faceID)
        case (iMin)
            if (dir .eq. 1) then
                I3 = 1
                J3 = i
                K3 = j
            else
                I3 = 2
                J3 = i
                K3 = j
            end if
        case (iMax)
            I3 = cudaDoms(dm,sps)%il
            J3 = i
            K3 = j
        case (jMin)
            if (dir .eq. 1) then
                I3 = i
                J3 = 1
                K3 = j
            else
                I3 = i
                J3 = 2
                K3 = j
            end if
        case (jMax)
            I3 = i
            J3 = cudaDoms(dm,sps)%jl
            K3 = j
        case (kMin)
            if (dir .eq. 1) then
                I3 = i
                J3 = j
                K3 = 1
            else
                I3 = i
                J3 = j
                K3 = 2
            end if
        case (kMax)
            I3 = i
            J3 = j
            K3 = cudaDoms(dm,sps)%kl
        end select

    end subroutine spatialFaceIndices

end module cudaBCPointers
