    !         d2 = haloBlockOverset(ii)
    !         i2 = haloIndicesOverset(ii, 1) + 1
    !         j2 = haloIndicesOverset(ii, 2) + 1
    !         k2 = haloIndicesOverset(ii, 3) + 1

    !         w1 = donorInterpOverset(ii, 1)
    !         w2 = donorInterpOverset(ii, 2)
    !         w3 = donorInterpOverset(ii, 3)
    !         w4 = donorInterpOverset(ii, 4)
    !         w5 = donorInterpOverset(ii, 5)
    !         w6 = donorInterpOverset(ii, 6)
    !         w7 = donorInterpOverset(ii, 7)
    !         w8 = donorInterpOverset(ii, 8)

    !         do v = start, end
    !             d_cudaDoms(d2, sps)%w(i2, j2, k2, v) = &
