    !                 w8 * d_cudaDoms(d1, sps)%w(i1 + 1, j1 + 1, k1 + 1, v)
    !         end do

    !         if (commPressure) then
    !             d_cudaDoms(d2, sps)%p(i2, j2, k2) = &
    !                 w1 * d_cudaDoms(d1, sps)%p(i1, j1, k1) + &
    !                 w2 * d_cudaDoms(d1, sps)%p(i1 + 1, j1, k1) + &
    !                 w3 * d_cudaDoms(d1, sps)%p(i1, j1 + 1, k1) + &
    !                 w4 * d_cudaDoms(d1, sps)%p(i1 + 1, j1 + 1, k1) + &
    !                 w5 * d_cudaDoms(d1, sps)%p(i1, j1, k1 + 1) + &
    !                 w6 * d_cudaDoms(d1, sps)%p(i1 + 1, j1, k1 + 1) + &
    !                 w7 * d_cudaDoms(d1, sps)%p(i1, j1 + 1, k1 + 1) + &
