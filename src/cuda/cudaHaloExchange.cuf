    ! end subroutine wOversetKernel

    ! attributes(global) subroutine orphanAverageKernel(wstart, wend, calcPressure, calcGamma, &
    !                                                   calcLamVis, calcEddyVis, nOrphans)
    !     !
    !     !       One thread per orphan cell (flattened across all blocks -- see
    !     !       allocateCudaHaloCommOrphans): averages the flow state of whichever of the 6
    !     !       face-neighbors (+/-i, +/-j, +/-k) have iblank == 1, or falls back to
    !     !       freestream if none do. Mirrors the `orphanLoop` inside
    !     !       haloExchange::orphanAverage. `sps` is hardcoded to 1, same as whalo1to1Kernel.
    !     !
    !     !       Caveat: d_cudaDoms(...)%iblank is only allocated over the interior
    !     !       (2:il,2:jl,2:kl) on the GPU (see cudaBlock.cuf's allocateCudaBlock) -- unlike
    !     !       the CPU's iblank, which also covers halo cells. A neighbor that lands outside
    !     !       that interior range is therefore always treated as unusable here (skipped),
    !     !       rather than checked, which is a real (if narrow) behavior difference from the
    !     !       CPU version.
    !     !
    !     use constants
    !     use cudaBlock, only: d_cudaDoms
    !     use cudaFlowVarRefState, only: wInf, pInfCorr, gammaInf, muInf, eddyVisInfRatio
    !     implicit none

    !     integer(kind=intType), intent(in), value :: wstart, wend, nOrphans
    !     logical, intent(in), value :: calcPressure, calcGamma, calcLamVis, calcEddyVis

    !     integer(kind=intType), parameter :: sps = 1 ! single-spectral harness
    !     integer(kind=intType) :: ii, dm
    !     integer(kind=intType) :: oi, oj, ok, ni, nj, nk, l, m, dl
    !     integer(kind=intType), dimension(3) :: del
    !     integer(kind=intType) :: nAvg
    !     real(kind=realType) :: nAvgReal
    !     logical :: neighborValid

    !     ii = (blockIdx%x - 1) * blockDim%x + threadIdx%x

    !     if (ii <= nOrphans) then

    !         dm = orphanBlock(ii)
    !         oi = orphanIndices(ii, 1)
    !         oj = orphanIndices(ii, 2)
    !         ok = orphanIndices(ii, 3)

    !         nAvg = 0

    !         do l = wstart, wend
    !             d_cudaDoms(dm, sps)%w(oi, oj, ok, l) = zero
    !         end do
    !         if (calcPressure) d_cudaDoms(dm, sps)%p(oi, oj, ok) = zero
    !         if (calcGamma) d_cudaDoms(dm, sps)%gamma(oi, oj, ok) = zero
    !         if (calcLamVis) d_cudaDoms(dm, sps)%rlv(oi, oj, ok) = zero
    !         if (calcEddyVis) d_cudaDoms(dm, sps)%rev(oi, oj, ok) = zero

    !         do m = 1, 3
    !             do dl = -1, 1, 2

    !                 del = 0
    !                 del(m) = dl

    !                 ni = oi + del(1)
    !                 nj = oj + del(2)
    !                 nk = ok + del(3)

    !                 neighborValid = .false.
    !                 if (ni >= 0 .and. ni <= d_cudaDoms(dm, sps)%ib .and. &
    !                     nj >= 0 .and. nj <= d_cudaDoms(dm, sps)%jb .and. &
    !                     nk >= 0 .and. nk <= d_cudaDoms(dm, sps)%kb) then

    !                     ! iblank only has backing memory on the interior -- see caveat above.
    !                     if (ni >= 2 .and. ni <= d_cudaDoms(dm, sps)%il .and. &
    !                         nj >= 2 .and. nj <= d_cudaDoms(dm, sps)%jl .and. &
    !                         nk >= 2 .and. nk <= d_cudaDoms(dm, sps)%kl) then
    !                         neighborValid = (d_cudaDoms(dm, sps)%iblank(ni, nj, nk) == 1)
    !                     end if
    !                 end if

    !                 if (neighborValid) then

    !                     nAvg = nAvg + 1

    !                     do l = wstart, wend
    !                         d_cudaDoms(dm, sps)%w(oi, oj, ok, l) = d_cudaDoms(dm, sps)%w(oi, oj, ok, l) &
    !                                                                + d_cudaDoms(dm, sps)%w(ni, nj, nk, l)
    !                     end do

    !                     if (calcPressure) d_cudaDoms(dm, sps)%p(oi, oj, ok) = d_cudaDoms(dm, sps)%p(oi, oj, ok) &
    !                                                                           + d_cudaDoms(dm, sps)%p(ni, nj, nk)
    !                     if (calcGamma) d_cudaDoms(dm, sps)%gamma(oi, oj, ok) = d_cudaDoms(dm, sps)%gamma(oi, oj, ok) &
    !                                                                           + d_cudaDoms(dm, sps)%gamma(ni, nj, nk)
    !                     if (calcLamVis) d_cudaDoms(dm, sps)%rlv(oi, oj, ok) = d_cudaDoms(dm, sps)%rlv(oi, oj, ok) &
    !                                                                          + d_cudaDoms(dm, sps)%rlv(ni, nj, nk)
    !                     if (calcEddyVis) d_cudaDoms(dm, sps)%rev(oi, oj, ok) = d_cudaDoms(dm, sps)%rev(oi, oj, ok) &
    !                                                                           + d_cudaDoms(dm, sps)%rev(ni, nj, nk)
    !                 end if

    !             end do
    !         end do

    !         if (nAvg > 0) then
    !             nAvgReal = real(nAvg, realType)

    !             do l = wstart, wend
    !                 d_cudaDoms(dm, sps)%w(oi, oj, ok, l) = d_cudaDoms(dm, sps)%w(oi, oj, ok, l) / nAvgReal
    !             end do
    !             if (calcPressure) d_cudaDoms(dm, sps)%p(oi, oj, ok) = d_cudaDoms(dm, sps)%p(oi, oj, ok) / nAvgReal
    !             if (calcGamma) d_cudaDoms(dm, sps)%gamma(oi, oj, ok) = d_cudaDoms(dm, sps)%gamma(oi, oj, ok) / nAvgReal
    !             if (calcLamVis) d_cudaDoms(dm, sps)%rlv(oi, oj, ok) = d_cudaDoms(dm, sps)%rlv(oi, oj, ok) / nAvgReal
    !             if (calcEddyVis) d_cudaDoms(dm, sps)%rev(oi, oj, ok) = d_cudaDoms(dm, sps)%rev(oi, oj, ok) / nAvgReal
    !         else
    !             do l = wstart, wend
    !                 d_cudaDoms(dm, sps)%w(oi, oj, ok, l) = wInf(l)
    !             end do
    !             if (calcPressure) d_cudaDoms(dm, sps)%p(oi, oj, ok) = pInfCorr
    !             if (calcGamma) d_cudaDoms(dm, sps)%gamma(oi, oj, ok) = gammaInf
    !             if (calcLamVis) d_cudaDoms(dm, sps)%rlv(oi, oj, ok) = muInf
    !             if (calcEddyVis) d_cudaDoms(dm, sps)%rev(oi, oj, ok) = eddyVisInfRatio * muInf
    !         end if

    !     end if

    ! end subroutine orphanAverageKernel

    ! attributes(global) subroutine computeEtotBlockKernel(dom, sps, iBeg, iEnd, jBeg, jEnd, &
    !                                                      kBeg, kEnd, correctForK)
    !     !
    !     !       One thread per (i,j,k) cell in the given range: recomputes rhoE from
    !     !       rho/velocity/p (and, if correctForK, the turbulent kinetic energy). Ports
    !     !       flowUtils::computeEtotBlock's cpConstant branch -- the same formula already
    !     !       implemented for BC halo layers in cudaBCRoutines::computeEtot, generalized to
    !     !       an explicit 3D (i,j,k) range instead of a boundary face layer. cpTempCurveFits
    !     !       is out of scope, same as cudaBCRoutines::computeEtot.
    !     !
    !     use constants
    !     use cudaInputPhysics, only: gammaConstant
    !     use cudaBlock, only: d_cudaDoms
    !     implicit none

    !     integer(kind=intType), intent(in), value :: dom, sps
    !     integer(kind=intType), intent(in), value :: iBeg, iEnd, jBeg, jEnd, kBeg, kEnd
    !     logical, intent(in), value :: correctForK

    !     integer(kind=intType) :: i, j, k
    !     real(kind=realType) :: ovgm1, factK

